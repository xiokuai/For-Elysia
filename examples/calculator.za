// 致爱 (Zhiai) 编程语言 — 科学计算器
// 使用内置的 Tkinter 绑定实现图形界面

输出("正在初始化致爱计算器...")

让 窗口 = 创建窗口("致爱计算器", 320, 420)
让 显示屏 = 创建文本框(窗口, 0, 0, 4)
设置文本(显示屏, "0")

让 当前输入 = "0"
让 记录 = ""
让 运算符 = ""
让 准备重置 = 假

函数 更新显示(文本)
  设置文本(显示屏, 文本)
结束

函数 按下数字(数字)
  如果 准备重置 则
    当前输入 = 数字
    准备重置 = 假
  否则
    如果 当前输入 == "0" 则
      当前输入 = 数字
    否则
      当前输入 = 当前输入 + 数字
    结束
  结束
  更新显示(当前输入)
结束

函数 按下运算符(新运算符)
  运算符 = 新运算符
  记录 = 当前输入
  准备重置 = 真
结束

函数 计算结果()
  如果 记录 == "" 或者 运算符 == "" 则 返回 空 结束
  
  让 a = 转换数字(记录)
  让 b = 转换数字(当前输入)
  让 结果 = 0
  
  如果 运算符 == "+" 则 结果 = a + b 结束
  如果 运算符 == "-" 则 结果 = a - b 结束
  如果 运算符 == "*" 则 结果 = a * b 结束
  如果 运算符 == "/" 则
    如果 b == 0 则
      对话框("错误：除数不能为零", "运算错误")
      清除()
      返回 空
    结束
    结果 = a / b
  结束
  
  当前输入 = 转换文字(结果)
  记录 = ""
  运算符 = ""
  准备重置 = 真
  更新显示(当前输入)
结束

函数 清除()
  当前输入 = "0"
  记录 = ""
  运算符 = ""
  准备重置 = 假
  更新显示(当前输入)
结束

// 界面布局 — 按钮网格
// 第一行: 7 8 9 /
创建按钮(窗口, "7", 1, 0, 函数() 按下数字("7") 结束)
创建按钮(窗口, "8", 1, 1, 函数() 按下数字("8") 结束)
创建按钮(窗口, "9", 1, 2, 函数() 按下数字("9") 结束)
创建按钮(窗口, "÷", 1, 3, 函数() 按下运算符("/") 结束)

// 第二行: 4 5 6 *
创建按钮(窗口, "4", 2, 0, 函数() 按下数字("4") 结束)
创建按钮(窗口, "5", 2, 1, 函数() 按下数字("5") 结束)
创建按钮(窗口, "6", 2, 2, 函数() 按下数字("6") 结束)
创建按钮(窗口, "×", 2, 3, 函数() 按下运算符("*") 结束)

// 第三行: 1 2 3 -
创建按钮(窗口, "1", 3, 0, 函数() 按下数字("1") 结束)
创建按钮(窗口, "2", 3, 1, 函数() 按下数字("2") 结束)
创建按钮(窗口, "3", 3, 2, 函数() 按下数字("3") 结束)
创建按钮(窗口, "—", 3, 3, 函数() 按下运算符("-") 结束)

// 第四行: C 0 = +
创建按钮(窗口, "清空", 4, 0, 函数() 清除() 结束)
创建按钮(窗口, "0", 4, 1, 函数() 按下数字("0") 结束)
创建按钮(窗口, "＝", 4, 2, 函数() 计算结果() 结束)
创建按钮(窗口, "＋", 4, 3, 函数() 按下运算符("+") 结束)

输出("致爱计算器启动成功！")
进入主循环(窗口)
