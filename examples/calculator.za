// 致爱语言 — 简易计算器

函数 加(甲, 乙)
  返回 甲 + 乙
结束

函数 减(甲, 乙)
  返回 甲 - 乙
结束

函数 乘(甲, 乙)
  返回 甲 * 乙
结束

函数 除(甲, 乙)
  如果 乙 == 0 则
    输出("错误：不能除以零！")
    返回 空
  结束
  返回 甲 / 乙
结束

输出("╔═══════════════════════╗")
输出("║   致爱计算器 v1.0     ║")
输出("╚═══════════════════════╝")
输出("")

// 测试运算
让 a = 10
让 b = 3

输出("a = " + 转换文字(a))
输出("b = " + 转换文字(b))
输出("")

输出("a + b = " + 转换文字(加(a, b)))
输出("a - b = " + 转换文字(减(a, b)))
输出("a * b = " + 转换文字(乘(a, b)))
输出("a / b = " + 转换文字(除(a, b)))
输出("a % b = " + 转换文字(a % b))
输出("a ** b = " + 转换文字(a ** b))

输出("")
输出("平方根(a) = " + 转换文字(平方根(a)))
输出("绝对值(-a) = " + 转换文字(绝对值(-a)))
