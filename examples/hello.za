// 致爱语言 — Hello World 示例

输出("你好，世界！")
输出("欢迎使用致爱编程语言！")

// 变量
让 名字 = "致爱To Elysia"
输出("我的名字是：" + 名字)

// 数字运算
让 年龄 = 1 + 1
输出("1 + 1 = " + 转换文字(年龄))

// 布尔
让 是真的 = 真
如果 是真的 则
  输出("这是真的！")
否则
  输出("这是假的！")
结束

// 数组
让 水果 = ["苹果", "香蕉", "橙子"]
输出("水果：" + 转换文字(水果))
输出("水果数量：" + 转换文字(长度(水果)))

// 对象
让 人 = {"名字": "小明", "年龄": 18, "爱好": "编程"}
输出("人：" + 转换文字(人))
输出("名字：" + 人["名字"])
