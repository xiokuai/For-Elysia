// 编译器功能测试

// 函数定义
函数 加法(甲, 乙)
  返回 甲 + 乙
结束

// 循环
让 总和 = 0
让 计数 = 0
当 计数 < 10 时
  总和 = 总和 + 计数
  计数 = 计数 + 1
结束
输出("0到9的和: " + 转换文字(总和))

// 函数调用
让 结果 = 加法(3, 4)
输出("3 + 4 = " + 转换文字(结果))

// 数组操作
让 数字 = [1, 2, 3, 4, 5]
输出("数组: " + 转换文字(数字))
输出("长度: " + 转换文字(长度(数字)))

// 对象
让 配置 = {"版本": "1.0", "名称": "致爱"}
输出("配置: " + 转换文字(配置))

// 条件
让 分数 = 85
如果 分数 >= 90 则
  输出("优秀")
否则如果 分数 >= 80 则
  输出("良好")
否则如果 分数 >= 60 则
  输出("及格")
否则
  输出("不及格")
结束
