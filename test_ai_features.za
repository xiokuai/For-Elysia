// 验证 AI 建议架构特性：契约 (Design by Contract) 与 通道 (Actor Model 基础)
输出("=== 高级架构特性验证 ===")

// 1. 契约编程验证
函数 存款(金额)
    断言(金额 > 0, "存款金额必须大于 0")
    输出("存款成功: " + 转换文字(金额))
结束

尝试
    存款(100)
    存款(-50) // 这会触发契约异常
捕获 异常
    输出("预期的契约拦截: " + 异常)
结束


// 2. 通信通道验证 (Go-style CSP)
让 信道 = 创建通道(10)

异步 函数 生产者(管道)
    对于 每个 元素 在 [1, 2, 3] 中
        输出("[生产者] 正在发送: " + 转换文字(元素))
        管道.发送(元素)
    结束
    管道.发送("EOF")
结束

异步 函数 消费者(管道)
    当 真 时
        让 元素 = 管道.接收()
        如果 元素 == "EOF" 则
            输出("[消费者] 收到结束信号，退出")
            中断
        结束
        输出("[消费者] 接收到: " + 转换文字(元素))
    结束
结束

// 启动协程
让 产者任务 = 异步(生产者, 信道)
让 消者任务 = 异步(消费者, 信道)

// 等待完成
产者任务.获取()
消者任务.获取()

输出("=== 验证完成 ===")
