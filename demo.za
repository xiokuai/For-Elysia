// 致爱语言演示程序

输出("=== 致爱语言演示 ===")
输出("")

// 1. 变量与运算
让 年 = 2026
让 月 = 5
让 日 = 16
输出("今天是 " + 转换文字(年) + "年" + 转换文字(月) + "月" + 转换文字(日) + "日")
输出("")

// 2. 递归求阶乘
函数 阶乘(数)
  如果 数 <= 1 则
    返回 1
  结束
  返回 数 * 阶乘(数 - 1)
结束

输出("5! = " + 转换文字(阶乘(5)))
输出("10! = " + 转换文字(阶乘(10)))
输出("")

// 3. 斐波那契
函数 斐波那契(数)
  如果 数 <= 1 则
    返回 数
  结束
  返回 斐波那契(数 - 1) + 斐波那契(数 - 2)
结束

输出("斐波那契数列前10项:")
让 索引 = 0
当 索引 < 10 时
  输出("  F(" + 转换文字(索引) + ") = " + 转换文字(斐波那契(索引)))
  索引 = 索引 + 1
结束
输出("")

// 4. 数组操作
让 颜色 = ["红", "橙", "黄", "绿", "蓝"]
输出("颜色: " + 转换文字(颜色))
输出("颜色数量: " + 转换文字(长度(颜色)))
输出("第一个: " + 颜色[0])
输出("最后一个: " + 颜色[长度(颜色) - 1])
输出("")

// 5. 对象操作
让 学生 = {
  "姓名": "小明",
  "年龄": 18,
  "成绩": [92, 88, 95, 76, 100]
}
输出("学生: " + 转换文字(学生))
输出("姓名: " + 学生["姓名"])

让 总分 = 0
让 成绩索引 = 0
当 成绩索引 < 长度(学生["成绩"]) 时
  总分 = 总分 + 学生["成绩"][成绩索引]
  成绩索引 = 成绩索引 + 1
结束
让 平均分 = 总分 / 长度(学生["成绩"])
输出("平均分: " + 转换文字(平均分))
输出("")

// 6. 条件判断
函数 等级(分数)
  如果 分数 >= 90 则
    返回 "优秀"
  否则如果 分数 >= 80 则
    返回 "良好"
  否则如果 分数 >= 70 则
    返回 "中等"
  否则如果 分数 >= 60 则
    返回 "及格"
  否则
    返回 "不及格"
  结束
结束

输出("95分 → " + 等级(95))
输出("82分 → " + 等级(82))
输出("67分 → " + 等级(67))
输出("45分 → " + 等级(45))
输出("")

// 7. 循环与累加
让 总和 = 0
让 循环索引 = 1
当 循环索引 <= 100 时
  总和 = 总和 + 循环索引
  循环索引 = 循环索引 + 1
结束
输出("1到100的和: " + 转换文字(总和))
输出("")

// 8. 数组求值
让 数字 = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
让 最大值 = 数字[0]
让 最小值 = 数字[0]
让 数字索引 = 1
当 数字索引 < 长度(数字) 时
  如果 数字[数字索引] > 最大值 则
    最大值 = 数字[数字索引]
  结束
  如果 数字[数字索引] < 最小值 则
    最小值 = 数字[数字索引]
  结束
  数字索引 = 数字索引 + 1
结束
输出("数组: " + 转换文字(数字))
输出("最大值: " + 转换文字(最大值))
输出("最小值: " + 转换文字(最小值))
输出("")

// 9. 字符串操作
让 句子 = "我爱编程"
输出("句子: " + 句子)
输出("长度: " + 转换文字(长度(句子)))
输出("前两字: " + 截取(句子, 0, 2))
输出("")

// 10. 嵌套函数
函数 最大公约数(甲, 乙)
  如果 乙 == 0 则
    返回 甲
  结束
  返回 最大公约数(乙, 甲 % 乙)
结束

函数 最小公倍数(甲, 乙)
  返回 甲 * 乙 / 最大公约数(甲, 乙)
结束

输出("最大公约数(12, 18) = " + 转换文字(最大公约数(12, 18)))
输出("最小公倍数(12, 18) = " + 转换文字(最小公倍数(12, 18)))
输出("")

// 11. 素数判断
函数 是素数(数)
  如果 数 < 2 则
    返回 假
  结束
  让 因子 = 2
  当 因子 * 因子 <= 数 时
    如果 数 % 因子 == 0 则
      返回 假
    结束
    因子 = 因子 + 1
  结束
  返回 真
结束

输出("20以内的素数:")
让 检查 = 2
让 素数列表 = ""
当 检查 <= 20 时
  如果 是素数(检查) 则
    如果 素数列表 != "" 则
      素数列表 = 素数列表 + ", "
    结束
    素数列表 = 素数列表 + 转换文字(检查)
  结束
  检查 = 检查 + 1
结束
输出(素数列表)
输出("")

输出("=== 演示结束 ===")
