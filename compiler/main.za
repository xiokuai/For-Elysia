// ═══════════════════════════════════════════════════════════════
//  致爱自举编译器 — 将 .za 源码编译为 .zab 字节码
//  用法: python -m zhiai compiler/main.za <输入.za> <输出.zab>
// ═══════════════════════════════════════════════════════════════

// ─── Token类型常量 ───
常量 TT_NUMBER = "NUMBER"
常量 TT_STRING = "STRING"
常量 TT_IDENT = "IDENT"
常量 TT_EOF = "EOF"
常量 TT_LET = "LET"
常量 TT_CONST = "CONST"
常量 TT_IF = "IF"
常量 TT_ELIF = "ELIF"
常量 TT_ELSE = "ELSE"
常量 TT_WHILE = "WHILE"
常量 TT_FOR = "FOR"
常量 TT_FROM = "FROM"
常量 TT_TO = "TO"
常量 TT_STEP = "STEP"
常量 TT_EACH = "EACH"
常量 TT_IN = "IN"
常量 TT_MID = "MID"
常量 TT_FUNC = "FUNC"
常量 TT_RETURN = "RETURN"
常量 TT_BREAK = "BREAK"
常量 TT_CONTINUE = "CONTINUE"
常量 TT_TRUE = "TRUE"
常量 TT_FALSE = "FALSE"
常量 TT_NULL = "NULL"
常量 TT_AND = "AND"
常量 TT_OR = "OR"
常量 TT_NOT = "NOT"
常量 TT_TRY = "TRY"
常量 TT_CATCH = "CATCH"
常量 TT_END = "END"
常量 TT_PLUS = "PLUS"
常量 TT_MINUS = "MINUS"
常量 TT_STAR = "STAR"
常量 TT_SLASH = "SLASH"
常量 TT_PERCENT = "PERCENT"
常量 TT_POWER = "POWER"
常量 TT_EQ = "EQ"
常量 TT_EQEQ = "EQEQ"
常量 TT_NEQ = "NEQ"
常量 TT_LT = "LT"
常量 TT_GT = "GT"
常量 TT_LTE = "LTE"
常量 TT_GTE = "GTE"
常量 TT_NOT_BANG = "NOT_BANG"
常量 TT_AND_AND = "AND_AND"
常量 TT_OR_OR = "OR_OR"
常量 TT_PLUS_EQ = "PLUS_EQ"
常量 TT_MINUS_EQ = "MINUS_EQ"
常量 TT_STAR_EQ = "STAR_EQ"
常量 TT_SLASH_EQ = "SLASH_EQ"
常量 TT_LPAREN = "LPAREN"
常量 TT_RPAREN = "RPAREN"
常量 TT_LBRACKET = "LBRACKET"
常量 TT_RBRACKET = "RBRACKET"
常量 TT_LBRACE = "LBRACE"
常量 TT_RBRACE = "RBRACE"
常量 TT_COMMA = "COMMA"
常量 TT_COLON = "COLON"
常量 TT_DOT = "DOT"

// ─── AST节点类型 ───
常量 N_NUMBER = "NUMBER"
常量 N_STRING = "STRING"
常量 N_BOOL = "BOOL"
常量 N_NULL = "NULL"
常量 N_ARRAY = "ARRAY"
常量 N_OBJECT = "OBJECT"
常量 N_IDENT = "IDENT"
常量 N_UNARY = "UNARY"
常量 N_BINARY = "BINARY"
常量 N_ASSIGN = "ASSIGN"
常量 N_CALL = "CALL"
常量 N_INDEX = "INDEX"
常量 N_PROPACCESS = "PROPACCESS"
常量 N_METHODCALL = "METHODCALL"
常量 N_PROGRAM = "PROGRAM"
常量 N_VARDECL = "VARDECL"
常量 N_CONSTDECL = "CONSTDECL"
常量 N_EXPRSTMT = "EXPRSTMT"
常量 N_IF = "IF"
常量 N_WHILE = "WHILE"
常量 N_FOR = "FOR"
常量 N_FOREACH = "FOREACH"
常量 N_FUNCDEF = "FUNCDEF"
常量 N_RETURN = "RETURN"
常量 N_BREAK = "BREAK"
常量 N_CONTINUE = "CONTINUE"
常量 N_TRYCATCH = "TRYCATCH"
常量 N_CLASSDEF = "CLASSDEF"


// ═══════════════════════════════════════════════════════════════
//  词法分析器
// ═══════════════════════════════════════════════════════════════

函数 新建词法分析器(源码, 文件名)
  返回 {
    "源码": 源码,
    "位置": 0,
    "行号": 1,
    "列号": 1,
    "文件名": 文件名,
    "关键字": {
      "让": TT_LET, "常量": TT_CONST, "如果": TT_IF,
      "否则如果": TT_ELIF, "否则": TT_ELSE,
      "当": TT_WHILE, "循环": TT_FOR, "对于": TT_FOR,
      "从": TT_FROM, "到": TT_TO, "步长": TT_STEP,
      "每个": TT_EACH, "在": TT_IN, "中": TT_MID,
      "函数": TT_FUNC, "返回": TT_RETURN,
      "中断": TT_BREAK, "继续": TT_CONTINUE,
      "真": TT_TRUE, "假": TT_FALSE, "空": TT_NULL,
      "并且": TT_AND, "或者": TT_OR, "非": TT_NOT,
      "尝试": TT_TRY, "捕获": TT_CATCH, "结束": TT_END,
      "输出": TT_IDENT, "长度": TT_IDENT, "转换文字": TT_IDENT,
      "读文件": TT_IDENT, "写文件": TT_IDENT, "错误": TT_IDENT,
      "追加文件": TT_IDENT, "文件存在": TT_IDENT
    }
  }
结束

函数 词法当前字符(词法)
  如果 词法["位置"] >= 长度(词法["源码"]) 则
    返回 空
  结束
  返回 词法["源码"][词法["位置"]]
结束

函数 词法前进(词法)
  让 字符 = 词法当前字符(词法)
  如果 字符 == "\n" 则
    词法["行号"] = 词法["行号"] + 1
    词法["列号"] = 1
  否则
    词法["列号"] = 词法["列号"] + 1
  结束
  词法["位置"] = 词法["位置"] + 1
  返回 字符
结束

函数 词法窥探(词法)
  如果 词法["位置"] + 1 >= 长度(词法["源码"]) 则
    返回 空
  结束
  返回 词法["源码"][词法["位置"] + 1]
结束

函数 词法跳过空白和注释(词法)
  当 词法["位置"] < 长度(词法["源码"]) 时
    让 字符 = 词法当前字符(词法)

    // 单行注释 //
    如果 字符 == "/" 并且 词法窥探(词法) == "/" 则
      词法前进(词法)
      词法前进(词法)
      当 词法["位置"] < 长度(词法["源码"]) 并且 词法当前字符(词法) != "\n" 时
        词法前进(词法)
      结束
      继续
    结束

    // 多行注释 /* */
    如果 字符 == "/" 并且 词法窥探(词法) == "*" 则
      词法前进(词法)
      词法前进(词法)
      当 词法["位置"] < 长度(词法["源码"]) 时
        如果 词法当前字符(词法) == "*" 并且 词法窥探(词法) == "/" 则
          词法前进(词法)
          词法前进(词法)
          中断
        结束
        词法前进(词法)
      结束
      继续
    结束

    // 空白字符
    如果 字符 == " " 或者 字符 == "\t" 或者 字符 == "\n" 或者 字符 == "\r" 则
      词法前进(词法)
      继续
    结束

    中断
  结束
结束

函数 词法读取数字(词法)
  让 起始位置 = 词法["位置"]
  让 有小数点 = 假
  当 词法["位置"] < 长度(词法["源码"]) 时
    让 字符 = 词法当前字符(词法)
    如果 字符 >= "0" 并且 字符 <= "9" 则
      词法前进(词法)
    否则如果 字符 == "." 并且 非 有小数点 则
      有小数点 = 真
      词法前进(词法)
    否则
      中断
    结束
  结束
  让 文本 = 截取(词法["源码"], 起始位置, 词法["位置"])
  返回 {"类型": TT_NUMBER, "值": 转换数字(文本), "行号": 词法["行号"]}
结束

函数 词法读取字符串(词法)
  让 引号 = 词法前进(词法)
  让 部分 = []
  当 词法["位置"] < 长度(词法["源码"]) 并且 词法当前字符(词法) != 引号 时
    如果 词法当前字符(词法) == "\\" 则
      词法前进(词法)
      让 转义字符 = 词法前进(词法)
      如果 转义字符 == "n" 则
        添加(部分, "\n")
      否则如果 转义字符 == "t" 则
        添加(部分, "\t")
      否则如果 转义字符 == "\\" 则
        添加(部分, "\\")
      否则如果 转义字符 == "\"" 则
        添加(部分, "\"")
      否则如果 转义字符 == "'" 则
        添加(部分, "'")
      否则
        添加(部分, 转义字符)
      结束
    否则
      添加(部分, 词法前进(词法))
    结束
  结束
  如果 词法["位置"] < 长度(词法["源码"]) 则
    词法前进(词法)  // 跳过结束引号
  结束
  返回 {"类型": TT_STRING, "值": 连接(部分, ""), "行号": 词法["行号"]}
结束

函数 是中文字符(字符)
  让 码 = 字符码(字符)
  返回 (码 >= 19968 并且 码 <= 40959) 或者 (码 >= 12352 并且 码 <= 12543) 或者 (码 >= 65280 并且 码 <= 65519)
结束

函数 是标识符字符(字符)
  如果 字符 >= "a" 并且 字符 <= "z" 则 返回 真 结束
  如果 字符 >= "A" 并且 字符 <= "Z" 则 返回 真 结束
  如果 字符 >= "0" 并且 字符 <= "9" 则 返回 真 结束
  如果 字符 == "_" 则 返回 真 结束
  返回 是中文字符(字符)
结束

函数 词法读取标识符(词法)
  让 起始位置 = 词法["位置"]
  当 词法["位置"] < 长度(词法["源码"]) 并且 是标识符字符(词法当前字符(词法)) 时
    词法前进(词法)
  结束
  让 文本 = 截取(词法["源码"], 起始位置, 词法["位置"])
  让 类型 = TT_IDENT
  如果 对象有键(词法["关键字"], 文本) 则
    类型 = 词法["关键字"][文本]
  结束
  返回 {"类型": 类型, "值": 文本, "行号": 词法["行号"]}
结束

函数 词法生成(词法)
  让 词法单元 = []
  当 词法["位置"] < 长度(词法["源码"]) 时
    词法跳过空白和注释(词法)
    如果 词法["位置"] >= 长度(词法["源码"]) 则
      中断
    结束

    让 字符 = 词法当前字符(词法)
    让 行 = 词法["行号"]

    // 数字
    如果 字符 >= "0" 并且 字符 <= "9" 则
      添加(词法单元, 词法读取数字(词法))
      继续
    结束

    // 字符串 (支持 " 和 ')
    如果 字符 == "\"" 或者 字符 == "'" 则
      添加(词法单元, 词法读取字符串(词法))
      继续
    结束

    // 标识符/关键字
    如果 是标识符字符(字符) 则
      添加(词法单元, 词法读取标识符(词法))
      继续
    结束

    // 双字符运算符
    如果 字符 == "=" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_EQEQ, "值": "==", "行号": 行})
      继续
    结束
    如果 字符 == "!" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_NEQ, "值": "!=", "行号": 行})
      继续
    结束
    如果 字符 == "<" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_LTE, "值": "<=", "行号": 行})
      继续
    结束
    如果 字符 == ">" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_GTE, "值": ">=", "行号": 行})
      继续
    结束
    如果 字符 == "&" 并且 词法窥探(词法) == "&" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_AND_AND, "值": "&&", "行号": 行})
      继续
    结束
    如果 字符 == "|" 并且 词法窥探(词法) == "|" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_OR_OR, "值": "||", "行号": 行})
      继续
    结束
    如果 字符 == "*" 并且 词法窥探(词法) == "*" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_POWER, "值": "**", "行号": 行})
      继续
    结束
    如果 字符 == "+" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_PLUS_EQ, "值": "+=", "行号": 行})
      继续
    结束
    如果 字符 == "-" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_MINUS_EQ, "值": "-=", "行号": 行})
      继续
    结束
    如果 字符 == "*" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_STAR_EQ, "值": "*=", "行号": 行})
      继续
    结束
    如果 字符 == "/" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_SLASH_EQ, "值": "/=", "行号": 行})
      继续
    结束

    // 单字符运算符
    如果 字符 == "+" 则 词法前进(词法) 添加(词法单元, {"类型": TT_PLUS, "值": "+", "行号": 行}) 继续 结束
    如果 字符 == "-" 则 词法前进(词法) 添加(词法单元, {"类型": TT_MINUS, "值": "-", "行号": 行}) 继续 结束
    如果 字符 == "*" 则 词法前进(词法) 添加(词法单元, {"类型": TT_STAR, "值": "*", "行号": 行}) 继续 结束
    如果 字符 == "/" 则 词法前进(词法) 添加(词法单元, {"类型": TT_SLASH, "值": "/", "行号": 行}) 继续 结束
    如果 字符 == "%" 则 词法前进(词法) 添加(词法单元, {"类型": TT_PERCENT, "值": "%", "行号": 行}) 继续 结束
    如果 字符 == "<" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LT, "值": "<", "行号": 行}) 继续 结束
    如果 字符 == ">" 则 词法前进(词法) 添加(词法单元, {"类型": TT_GT, "值": ">", "行号": 行}) 继续 结束
    如果 字符 == "=" 则 词法前进(词法) 添加(词法单元, {"类型": TT_EQ, "值": "=", "行号": 行}) 继续 结束
    如果 字符 == "!" 则 词法前进(词法) 添加(词法单元, {"类型": TT_NOT_BANG, "值": "!", "行号": 行}) 继续 结束
    如果 字符 == "(" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LPAREN, "值": "(", "行号": 行}) 继续 结束
    如果 字符 == ")" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RPAREN, "值": ")", "行号": 行}) 继续 结束
    如果 字符 == "[" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LBRACKET, "值": "[", "行号": 行}) 继续 结束
    如果 字符 == "]" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RBRACKET, "值": "]", "行号": 行}) 继续 结束
    如果 字符 == "{" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LBRACE, "值": "{", "行号": 行}) 继续 结束
    如果 字符 == "}" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RBRACE, "值": "}", "行号": 行}) 继续 结束
    如果 字符 == "," 则 词法前进(词法) 添加(词法单元, {"类型": TT_COMMA, "值": ",", "行号": 行}) 继续 结束
    如果 字符 == ":" 则 词法前进(词法) 添加(词法单元, {"类型": TT_COLON, "值": ":", "行号": 行}) 继续 结束
    如果 字符 == "." 则 词法前进(词法) 添加(词法单元, {"类型": TT_DOT, "值": ".", "行号": 行}) 继续 结束

    错误(词法["文件名"] + ":" + 转换文字(行) + " 词法错误: 未知字符 '" + 字符 + "'")
  结束
  添加(词法单元, {"类型": TT_EOF, "值": "", "行号": 词法["行号"]})
  返回 词法单元
结束


// ═══════════════════════════════════════════════════════════════
//  语法分析器
// ═══════════════════════════════════════════════════════════════

函数 新建语法分析器(词法单元, 文件名)
  返回 {
    "词法单元": 词法单元,
    "位置": 0,
    "文件名": 文件名
  }
结束

函数 语法当前(解析器)
  返回 解析器["词法单元"][解析器["位置"]]
结束

函数 语法前进(解析器)
  让 当前 = 语法当前(解析器)
  解析器["位置"] = 解析器["位置"] + 1
  返回 当前
结束

函数 语法检查(解析器, 类型)
  返回 语法当前(解析器)["类型"] == 类型
结束

函数 语法期望(解析器, 类型, 消息)
  如果 语法当前(解析器)["类型"] != 类型 则
    让 实际 = 语法当前(解析器)["值"]
    如果 实际 == "" 则 实际 = 语法当前(解析器)["类型"] 结束
    错误(解析器["文件名"] + ":" + 转换文字(语法当前(解析器)["行号"]) + " 语法错误: " + 消息 + "，得到 '" + 实际 + "'")
  结束
  返回 语法前进(解析器)
结束

函数 语法匹配(解析器, 类型)
  如果 语法检查(解析器, 类型) 则
    语法前进(解析器)
    返回 真
  结束
  返回 假
结束

函数 解析程序(解析器)
  让 语句 = []
  当 非 语法检查(解析器, TT_EOF) 时
    添加(语句, 解析语句(解析器))
  结束
  返回 {"类型": N_PROGRAM, "语句": 语句}
结束

函数 解析语句(解析器)
  让 当前类型 = 语法当前(解析器)["类型"]

  如果 当前类型 == TT_LET 则 返回 解析变量声明(解析器) 结束
  如果 当前类型 == TT_CONST 则 返回 解析常量声明(解析器) 结束
  如果 当前类型 == TT_IF 则 返回 解析如果(解析器) 结束
  如果 当前类型 == TT_WHILE 则 返回 解析当循环(解析器) 结束
  如果 当前类型 == TT_FOR 则 返回 解析循环(解析器) 结束
  如果 当前类型 == TT_FUNC 则 返回 解析函数定义(解析器) 结束
  如果 当前类型 == TT_RETURN 则 返回 解析返回(解析器) 结束
  如果 当前类型 == TT_BREAK 则
    语法前进(解析器)
    返回 {"类型": N_BREAK}
  结束
  如果 当前类型 == TT_CONTINUE 则
    语法前进(解析器)
    返回 {"类型": N_CONTINUE}
  结束
  如果 当前类型 == TT_TRY 则 返回 解析尝试捕获(解析器) 结束
  如果 当前类型 == TT_IDENT 并且 语法当前(解析器)["值"] == "类" 则 返回 解析类定义(解析器) 结束

  // 表达式语句
  让 表达式 = 解析表达式(解析器)
  // 复合赋值: 标识符 += 表达式
  如果 表达式["类型"] == N_IDENT 则
    如果 语法检查(解析器, TT_PLUS_EQ) 或者 语法检查(解析器, TT_MINUS_EQ) 或者 语法检查(解析器, TT_STAR_EQ) 或者 语法检查(解析器, TT_SLASH_EQ) 则
      让 运算符词法单元 = 语法前进(解析器)
      让 运算符 = "+"
      如果 运算符词法单元["类型"] == TT_MINUS_EQ 则 运算符 = "-" 结束
      如果 运算符词法单元["类型"] == TT_STAR_EQ 则 运算符 = "*" 结束
      如果 运算符词法单元["类型"] == TT_SLASH_EQ 则 运算符 = "/" 结束
      让 右值 = 解析表达式(解析器)
      返回 {"类型": N_ASSIGN, "名称": 表达式["名称"], "值": {"类型": N_BINARY, "运算符": 运算符, "左": 表达式, "右": 右值}}
    结束
    如果 语法检查(解析器, TT_EQ) 则
      语法前进(解析器)
      让 右值 = 解析表达式(解析器)
      返回 {"类型": N_ASSIGN, "名称": 表达式["名称"], "值": 右值}
    结束
  结束
  返回 {"类型": N_EXPRSTMT, "表达式": 表达式}
结束

函数 解析变量声明(解析器)
  语法期望(解析器, TT_LET, "期望 '让'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望变量名")["值"]
  语法期望(解析器, TT_EQ, "期望 '='")
  让 值 = 解析表达式(解析器)
  返回 {"类型": N_VARDECL, "名称": 名称, "值": 值}
结束

函数 解析常量声明(解析器)
  语法期望(解析器, TT_CONST, "期望 '常量'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望常量名")["值"]
  语法期望(解析器, TT_EQ, "期望 '='")
  让 值 = 解析表达式(解析器)
  返回 {"类型": N_CONSTDECL, "名称": 名称, "值": 值}
结束

函数 解析如果主体(解析器)
  // 解析条件和则
  让 条件 = 解析表达式(解析器)
  语法期望(解析器, TT_IDENT, "期望 '则'")  // 则 被识别为标识符
  // 解析真分支
  让 真分支 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_ELSE) 并且 非 语法检查(解析器, TT_ELIF) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(真分支, 解析语句(解析器))
  结束
  // 处理否则如果 / 否则 / 结束
  让 假分支 = []
  如果 语法检查(解析器, TT_ELIF) 则
    语法前进(解析器)  // 消费 否则如果
    让 嵌套 = 解析如果主体(解析器)
    添加(假分支, {"类型": N_IF, "条件": 嵌套["条件"], "真分支": 嵌套["真分支"], "假分支": 嵌套["假分支"]})
  否则如果 语法匹配(解析器, TT_ELSE) 则
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(假分支, 解析语句(解析器))
    结束
  结束
  返回 {"条件": 条件, "真分支": 真分支, "假分支": 假分支}
结束

函数 解析如果(解析器)
  语法期望(解析器, TT_IF, "期望 '如果'")
  让 结果 = 解析如果主体(解析器)
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_IF, "条件": 结果["条件"], "真分支": 结果["真分支"], "假分支": 结果["假分支"]}
结束

函数 解析当循环(解析器)
  语法期望(解析器, TT_WHILE, "期望 '当'")
  让 条件 = 解析表达式(解析器)
  语法期望(解析器, TT_IDENT, "期望 '时'")  // 时 被识别为标识符
  让 主体 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(主体, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_WHILE, "条件": 条件, "主体": 主体}
结束

函数 解析循环(解析器)
  语法期望(解析器, TT_FOR, "期望 '循环' 或 '对于'")

  // 对于 每个 变量 在 数组 中
  如果 语法检查(解析器, TT_EACH) 则
    语法前进(解析器)
    让 变量名 = 语法期望(解析器, TT_IDENT, "期望变量名")["值"]
    语法期望(解析器, TT_IN, "期望 '在'")
    让 可迭代 = 解析表达式(解析器)
    语法期望(解析器, TT_MID, "期望 '中'")
    让 主体 = []
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(主体, 解析语句(解析器))
    结束
    语法期望(解析器, TT_END, "期望 '结束'")
    返回 {"类型": N_FOREACH, "变量名": 变量名, "可迭代": 可迭代, "主体": 主体}
  结束

  // 循环 变量 从 X 到 Y [步长 Z]
  让 变量名 = 语法期望(解析器, TT_IDENT, "期望循环变量名")["值"]
  如果 语法检查(解析器, TT_FROM) 则
    语法前进(解析器)
    让 起始值 = 解析表达式(解析器)
    语法期望(解析器, TT_TO, "期望 '到'")
    让 结束值 = 解析表达式(解析器)
    让 步长值 = 空
    如果 语法匹配(解析器, TT_STEP) 则
      步长值 = 解析表达式(解析器)
    结束
    让 主体 = []
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(主体, 解析语句(解析器))
    结束
    语法期望(解析器, TT_END, "期望 '结束'")
    返回 {"类型": N_FOR, "变量名": 变量名, "起始值": 起始值, "结束值": 结束值, "步长": 步长值, "主体": 主体}
  结束

  错误("循环语法错误")
结束

函数 解析函数定义(解析器)
  语法期望(解析器, TT_FUNC, "期望 '函数'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望函数名")["值"]
  语法期望(解析器, TT_LPAREN, "期望 '('")
  让 参数列表 = []
  如果 非 语法检查(解析器, TT_RPAREN) 则
    添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
    当 语法匹配(解析器, TT_COMMA) 时
      添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
    结束
  结束
  语法期望(解析器, TT_RPAREN, "期望 ')'")
  让 主体 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(主体, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_FUNCDEF, "名称": 名称, "参数列表": 参数列表, "主体": 主体}
结束

函数 解析尝试捕获(解析器)
  语法期望(解析器, TT_TRY, "期望 '尝试'")
  让 尝试块 = []
  当 非 语法检查(解析器, TT_CATCH) 并且 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(尝试块, 解析语句(解析器))
  结束
  
  让 变量名 = 空
  让 捕获块 = []
  如果 语法匹配(解析器, TT_CATCH) 则
    如果 语法检查(解析器, TT_LPAREN) 则
       语法前进(解析器)
       变量名 = 语法期望(解析器, TT_IDENT, "期望异常变量名")["值"]
       语法期望(解析器, TT_RPAREN, "期望 ')'")
    结束
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(捕获块, 解析语句(解析器))
    结束
  结束
  
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_TRYCATCH, "尝试块": 尝试块, "捕获块": 捕获块, "变量名": 变量名}
结束

函数 解析类定义(解析器)
  语法前进(解析器) // 消费 "类"
  让 名称 = 语法期望(解析器, TT_IDENT, "期望类名")["值"]
  让 方法 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(方法, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_CLASSDEF, "名称": 名称, "方法": 方法}
结束

函数 解析返回(解析器)
  语法期望(解析器, TT_RETURN, "期望 '返回'")
  让 值 = 空
  如果 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 并且 非 语法检查(解析器, TT_ELSE) 并且 非 语法检查(解析器, TT_ELIF) 并且 语法当前(解析器)["行号"] == 语法前进(解析器)["行号"] 则
    解析器["位置"] = 解析器["位置"] - 1
    值 = 解析表达式(解析器)
  结束
  如果 值 == 空 则
    值 = {"类型": N_NULL}
  结束
  返回 {"类型": N_RETURN, "值": 值}
结束

函数 解析表达式(解析器)
  返回 解析逻辑或(解析器)
结束

函数 解析逻辑或(解析器)
  让 左 = 解析逻辑与(解析器)
  当 语法检查(解析器, TT_OR) 或者 语法检查(解析器, TT_OR_OR) 时
    语法前进(解析器)
    让 右 = 解析逻辑与(解析器)
    左 = {"类型": N_BINARY, "运算符": "||", "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析逻辑与(解析器)
  让 左 = 解析比较(解析器)
  当 语法检查(解析器, TT_AND) 或者 语法检查(解析器, TT_AND_AND) 时
    语法前进(解析器)
    让 右 = 解析比较(解析器)
    左 = {"类型": N_BINARY, "运算符": "&&", "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析比较(解析器)
  让 左 = 解析加减(解析器)
  当 语法检查(解析器, TT_EQEQ) 或者 语法检查(解析器, TT_NEQ) 或者 语法检查(解析器, TT_LT) 或者 语法检查(解析器, TT_GT) 或者 语法检查(解析器, TT_LTE) 或者 语法检查(解析器, TT_GTE) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析加减(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析加减(解析器)
  让 左 = 解析乘除(解析器)
  当 语法检查(解析器, TT_PLUS) 或者 语法检查(解析器, TT_MINUS) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析乘除(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析乘除(解析器)
  让 左 = 解析幂(解析器)
  当 语法检查(解析器, TT_STAR) 或者 语法检查(解析器, TT_SLASH) 或者 语法检查(解析器, TT_PERCENT) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析幂(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析幂(解析器)
  让 左 = 解析一元(解析器)
  如果 语法检查(解析器, TT_POWER) 则
    语法前进(解析器)
    让 右 = 解析一元(解析器)
    左 = {"类型": N_BINARY, "运算符": "**", "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析一元(解析器)
  如果 语法检查(解析器, TT_MINUS) 或者 语法检查(解析器, TT_NOT) 或者 语法检查(解析器, TT_NOT_BANG) 则
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = "-"
    如果 运算符词法单元["类型"] == TT_NOT 或者 运算符词法单元["类型"] == TT_NOT_BANG 则
      运算符 = "!"
    结束
    让 操作数 = 解析一元(解析器)
    返回 {"类型": N_UNARY, "运算符": 运算符, "操作数": 操作数}
  结束
  返回 解析调用链(解析器)
结束

函数 解析调用链(解析器)
  让 节点 = 解析原子(解析器)
  当 真 时
    // 函数调用: 标识符(...)
    如果 语法检查(解析器, TT_LPAREN) 则
      语法前进(解析器)
      让 参数列表 = []
      如果 非 语法检查(解析器, TT_RPAREN) 则
        添加(参数列表, 解析表达式(解析器))
        当 语法匹配(解析器, TT_COMMA) 时
          添加(参数列表, 解析表达式(解析器))
        结束
      结束
      语法期望(解析器, TT_RPAREN, "期望 ')'")
      节点 = {"类型": N_CALL, "函数": 节点, "参数列表": 参数列表}
      继续
    结束

    // 索引访问: 标识符[索引]
    如果 语法检查(解析器, TT_LBRACKET) 则
      语法前进(解析器)
      让 索引 = 解析表达式(解析器)
      语法期望(解析器, TT_RBRACKET, "期望 ']'")
      // 索引赋值检查
      如果 语法检查(解析器, TT_EQ) 则
        语法前进(解析器)
        让 值 = 解析表达式(解析器)
        返回 {"类型": N_ASSIGN, "名称": 空, "索引": {"对象": 节点, "索引": 索引}, "值": 值}
      结束
      节点 = {"类型": N_INDEX, "对象": 节点, "索引": 索引}
      继续
    结束

    // 属性访问: 标识符.属性
    如果 语法检查(解析器, TT_DOT) 则
      语法前进(解析器)
      让 属性名 = 语法期望(解析器, TT_IDENT, "期望属性名")["值"]
      // 属性赋值检查
      如果 语法检查(解析器, TT_EQ) 则
        语法前进(解析器)
        让 值 = 解析表达式(解析器)
        返回 {"类型": N_ASSIGN, "名称": 空, "属性": {"对象": 节点, "属性": 属性名}, "值": 值}
      结束
      // 方法调用检查: 对象.方法(参数)
      如果 语法检查(解析器, TT_LPAREN) 则
        语法前进(解析器)
        让 参数列表 = []
        如果 非 语法检查(解析器, TT_RPAREN) 则
          添加(参数列表, 解析表达式(解析器))
          当 语法匹配(解析器, TT_COMMA) 时
            添加(参数列表, 解析表达式(解析器))
          结束
        结束
        语法期望(解析器, TT_RPAREN, "期望 ')'")
        节点 = {"类型": N_METHODCALL, "对象": 节点, "方法": 属性名, "参数列表": 参数列表}
      否则
        节点 = {"类型": N_PROPACCESS, "对象": 节点, "属性": 属性名}
      结束
      继续
    结束

    中断
  结束
  返回 节点
结束

函数 解析原子(解析器)
  让 当前 = 语法当前(解析器)

  // 数字
  如果 当前["类型"] == TT_NUMBER 则
    语法前进(解析器)
    返回 {"类型": N_NUMBER, "值": 当前["值"]}
  结束

  // 字符串
  如果 当前["类型"] == TT_STRING 则
    语法前进(解析器)
    返回 {"类型": N_STRING, "值": 当前["值"]}
  结束

  // 布尔
  如果 当前["类型"] == TT_TRUE 则
    语法前进(解析器)
    返回 {"类型": N_BOOL, "值": 真}
  结束
  如果 当前["类型"] == TT_FALSE 则
    语法前进(解析器)
    返回 {"类型": N_BOOL, "值": 假}
  结束

  // 空
  如果 当前["类型"] == TT_NULL 则
    语法前进(解析器)
    返回 {"类型": N_NULL}
  结束

  // 标识符
  如果 当前["类型"] == TT_IDENT 则
    语法前进(解析器)
    返回 {"类型": N_IDENT, "名称": 当前["值"]}
  结束

  // 括号表达式
  如果 当前["类型"] == TT_LPAREN 则
    语法前进(解析器)
    让 表达式 = 解析表达式(解析器)
    语法期望(解析器, TT_RPAREN, "期望 ')'")
    返回 表达式
  结束

  // 数组字面量
  如果 当前["类型"] == TT_LBRACKET 则
    语法前进(解析器)
    让 元素 = []
    如果 非 语法检查(解析器, TT_RBRACKET) 则
      添加(元素, 解析表达式(解析器))
      当 语法匹配(解析器, TT_COMMA) 时
        添加(元素, 解析表达式(解析器))
      结束
    结束
    语法期望(解析器, TT_RBRACKET, "期望 ']'")
    返回 {"类型": N_ARRAY, "元素": 元素}
  结束

  // 对象字面量
  如果 当前["类型"] == TT_LBRACE 则
    语法前进(解析器)
    让 键值对 = []
    如果 非 语法检查(解析器, TT_RBRACE) 则
      让 键 = 语法期望(解析器, TT_STRING, "期望字符串键")["值"]
      语法期望(解析器, TT_COLON, "期望 ':'")
      让 值 = 解析表达式(解析器)
      添加(键值对, {"键": 键, "值": 值})
      当 语法匹配(解析器, TT_COMMA) 时
        键 = 语法期望(解析器, TT_STRING, "期望字符串键")["值"]
        语法期望(解析器, TT_COLON, "期望 ':'")
        值 = 解析表达式(解析器)
        添加(键值对, {"键": 键, "值": 值})
      结束
    结束
    语法期望(解析器, TT_RBRACE, "期望 '}'")
    返回 {"类型": N_OBJECT, "键值对": 键值对}
  结束

  错误(解析器["文件名"] + ":" + 转换文字(当前["行号"]) + " 语法错误: 期望表达式，得到 '" + 当前["值"] + "'")
结束


// ═══════════════════════════════════════════════════════════════
//  字节码代码生成器
// ═══════════════════════════════════════════════════════════════

函数 新建代码生成器()
  返回 {
    "常量池": [],
    "指令": [],
    "跳出位置": [],
    "继续位置": []
  }
结束

函数 代码发射(生成器, 操作码, 参数1, 参数2, 参数3, 参数4, 参数5)
  让 指令 = [操作码]
  如果 参数1 != 空 则 添加(指令, 参数1) 结束
  如果 参数2 != 空 则 添加(指令, 参数2) 结束
  如果 参数3 != 空 则 添加(指令, 参数3) 结束
  如果 参数4 != 空 则 添加(指令, 参数4) 结束
  如果 参数5 != 空 则 添加(指令, 参数5) 结束
  添加(生成器["指令"], 指令)
  返回 长度(生成器["指令"]) - 1
结束

函数 代码添加常量(生成器, 值)
  // 手动查找，严格类型匹配
  让 池 = 生成器["常量池"]
  让 索引值 = 0
  当 索引值 < 长度(池) 时
    如果 类型(池[索引值]) == 类型(值) 并且 池[索引值] == 值 则
      返回 索引值
    结束
    索引值 = 索引值 + 1
  结束
  添加(生成器["常量池"], 值)
  返回 长度(生成器["常量池"]) - 1
结束

函数 代码当前位置(生成器)
  返回 长度(生成器["指令"])
结束

函数 代码修补跳转(生成器, 指令位置, 目标位置)
  生成器["指令"][指令位置] = [生成器["指令"][指令位置][0], 目标位置]
结束

函数 编译节点(生成器, 节点)
  让 类型 = 节点["类型"]

  如果 类型 == N_NUMBER 则
    让 下标 = 代码添加常量(生成器, 节点["值"])
    代码发射(生成器, "PUSH", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_STRING 则
    让 下标 = 代码添加常量(生成器, 节点["值"])
    代码发射(生成器, "PUSH", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_BOOL 则
    如果 节点["值"] 则
      代码发射(生成器, "PUSH", 代码添加常量(生成器, 真), 空, 空, 空, 空)
    否则
      代码发射(生成器, "PUSH", 代码添加常量(生成器, 假), 空, 空, 空, 空)
    结束
    返回
  结束

  如果 类型 == N_NULL 则
    代码发射(生成器, "PUSH", 代码添加常量(生成器, 空), 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_IDENT 则
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "LOAD", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_ARRAY 则
    让 长度值 = 长度(节点["元素"])
    // 正序编译，VM的MAKE_ARRAY会反转
    让 索引值 = 0
    当 索引值 < 长度值 时
      编译节点(生成器, 节点["元素"][索引值])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "MAKE_ARRAY", 长度值, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_OBJECT 则
    让 长度值 = 长度(节点["键值对"])
    // 正序推入: 值, 键, 值, 键, ... (键在栈顶)
    让 索引值 = 0
    当 索引值 < 长度值 时
      让 对 = 节点["键值对"][索引值]
      让 键下标 = 代码添加常量(生成器, 对["键"])
      代码发射(生成器, "PUSH", 键下标, 空, 空, 空, 空)
      编译节点(生成器, 对["值"])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "MAKE_OBJECT", 长度值, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_UNARY 则
    编译节点(生成器, 节点["操作数"])
    如果 节点["运算符"] == "-" 则
      代码发射(生成器, "NEG", 空, 空, 空, 空, 空)
    否则
      代码发射(生成器, "NOT", 空, 空, 空, 空, 空)
    结束
    返回
  结束

  如果 类型 == N_BINARY 则
    // 常量折叠尝试
    如果 节点["左"]["类型"] == N_NUMBER 并且 节点["右"]["类型"] == N_NUMBER 则
      让 a = 节点["左"]["值"]
      让 b = 节点["右"]["值"]
      让 运算符 = 节点["运算符"]
      如果 运算符 == "+" 则 代码发射(生成器, "PUSH", 代码添加常量(生成器, a + b), 空, 空, 空, 空) 返回 结束
      如果 运算符 == "-" 则 代码发射(生成器, "PUSH", 代码添加常量(生成器, a - b), 空, 空, 空, 空) 返回 结束
      如果 运算符 == "*" 则 代码发射(生成器, "PUSH", 代码添加常量(生成器, a * b), 空, 空, 空, 空) 返回 结束
      如果 运算符 == "/" 并且 b != 0 则 代码发射(生成器, "PUSH", 代码添加常量(生成器, a / b), 空, 空, 空, 空) 返回 结束
    结束

    编译节点(生成器, 节点["左"])
    编译节点(生成器, 节点["右"])
    让 运算符 = 节点["运算符"]
    如果 运算符 == "+" 则 代码发射(生成器, "ADD", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "-" 则 代码发射(生成器, "SUB", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "*" 则 代码发射(生成器, "MUL", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "/" 则 代码发射(生成器, "DIV", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "%" 则 代码发射(生成器, "MOD", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "**" 则 代码发射(生成器, "POW", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "==" 则 代码发射(生成器, "EQ", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "!=" 则 代码发射(生成器, "NEQ", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "<" 则 代码发射(生成器, "LT", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == ">" 则 代码发射(生成器, "GT", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "<=" 则 代码发射(生成器, "LTE", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == ">=" 则 代码发射(生成器, "GTE", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "&&" 则 代码发射(生成器, "AND", 空, 空, 空, 空, 空) 返回 结束
    如果 运算符 == "||" 则 代码发射(生成器, "OR", 空, 空, 空, 空, 空) 返回 结束
    错误("未知运算符: " + 运算符)
    返回
  结束

  如果 类型 == N_ASSIGN 则
    编译节点(生成器, 节点["值"])
    // 索引赋值: arr[idx] = val
    如果 对象有键(节点, "索引") 并且 节点["索引"] != 空 则
      编译节点(生成器, 节点["索引"]["对象"])
      编译节点(生成器, 节点["索引"]["索引"])
      代码发射(生成器, "STORE_INDEX", 空, 空, 空, 空, 空)
      返回
    结束
    // 属性赋值: obj.prop = val
    如果 对象有键(节点, "属性") 并且 节点["属性"] != 空 则
      编译节点(生成器, 节点["属性"]["对象"])
      让 下标 = 代码添加常量(生成器, 节点["属性"]["属性"])
      代码发射(生成器, "STORE_PROP", 下标, 空, 空, 空, 空)
      返回
    结束
    // 变量赋值
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "STORE", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_CALL 则
    // 先编译函数引用
    编译节点(生成器, 节点["函数"])
    // 再编译参数
    让 长度值 = 长度(节点["参数列表"])
    让 索引值 = 0
    当 索引值 < 长度值 时
      编译节点(生成器, 节点["参数列表"][索引值])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "CALL", 长度值, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_INDEX 则
    编译节点(生成器, 节点["对象"])
    编译节点(生成器, 节点["索引"])
    代码发射(生成器, "LOAD_INDEX", 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_PROPACCESS 则
    编译节点(生成器, 节点["对象"])
    让 下标 = 代码添加常量(生成器, 节点["属性"])
    代码发射(生成器, "LOAD_PROP", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_METHODCALL 则
    // 检查是否可以使用 BATCH_OP
    让 方法名 = 节点["方法"]
    让 参数列表 = 节点["参数列表"]
    让 参数数量 = 长度(参数列表)
    让 批处理ID = 0

    如果 方法名 == "筛选" 并且 参数数量 == 1 则 批处理ID = 1 结束
    如果 方法名 == "映射" 并且 参数数量 == 1 则 批处理ID = 2 结束
    如果 方法名 == "排序" 并且 参数数量 == 0 则 批处理ID = 3 结束
    如果 方法名 == "分割" 并且 参数数量 == 1 则 批处理ID = 4 结束
    如果 方法名 == "替换" 并且 参数数量 == 2 则 批处理ID = 5 结束

    如果 批处理ID > 0 则
      编译节点(生成器, 节点["对象"])
      让 索引值 = 0
      当 索引值 < 参数数量 时
        编译节点(生成器, 参数列表[索引值])
        索引值 = 索引值 + 1
      结束
      代码发射(生成器, "BATCH_OP", 批处理ID, 参数数量 + 1, 空, 空, 空)
      返回
    结束

    // 常规方法调用 (回退)
    编译节点(生成器, 节点["对象"])
    让 索引值 = 0
    当 索引值 < 参数数量 时
      编译节点(生成器, 参数列表[索引值])
      索引值 = 索引值 + 1
    结束
    让 方法下标 = 代码添加常量(生成器, 方法名)
    代码发射(生成器, "CALL_METHOD", 方法下标, 参数数量, 空, 空, 空)
    返回
  结束

  // ── 语句 ──

  如果 类型 == N_PROGRAM 则
    让 索引值 = 0
    当 索引值 < 长度(节点["语句"]) 时
      编译语句(生成器, 节点["语句"][索引值])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "HALT", 空, 空, 空, 空, 空)
    返回
  结束

  错误("未实现的节点类型: " + 类型)
结束

函数 编译语句(生成器, 节点)
  让 类型 = 节点["类型"]

  如果 类型 == N_VARDECL 则
    编译节点(生成器, 节点["值"])
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "DEF", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_CONSTDECL 则
    编译节点(生成器, 节点["值"])
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "DEF", 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_EXPRSTMT 则
    编译节点(生成器, 节点["表达式"])
    代码发射(生成器, "POP", 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_IF 则
    编译节点(生成器, 节点["条件"])
    让 假跳过 = 代码发射(生成器, "JMP_IFNOT", 0, 空, 空, 空, 空)
    // 真分支
    让 索引值 = 0
    当 索引值 < 长度(节点["真分支"]) 时
      编译语句(生成器, 节点["真分支"][索引值])
      索引值 = 索引值 + 1
    结束
    让 结束跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空)
    // 假分支
    代码修补跳转(生成器, 假跳过, 代码当前位置(生成器))
    索引值 = 0
    当 索引值 < 长度(节点["假分支"]) 时
      编译语句(生成器, 节点["假分支"][索引值])
      索引值 = 索引值 + 1
    结束
    代码修补跳转(生成器, 结束跳转, 代码当前位置(生成器))
    返回
  结束

  如果 类型 == N_WHILE 则
    让 循环开始 = 代码当前位置(生成器)
    编译节点(生成器, 节点["条件"])
    让 退出跳转 = 代码发射(生成器, "JMP_IFNOT", 0, 空, 空, 空, 空)
    // 主体
    添加(生成器["跳出位置"], [])
    添加(生成器["继续位置"], 循环开始)
    让 索引值 = 0
    当 索引值 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引值])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "JMP", 循环开始, 空, 空, 空, 空)
    代码修补跳转(生成器, 退出跳转, 代码当前位置(生成器))
    // 修补中断
    让 跳出列表 = 生成器["跳出位置"][长度(生成器["跳出位置"]) - 1]
    让 跳出索引 = 0
    当 跳出索引 < 长度(跳出列表) 时
      代码修补跳转(生成器, 跳出列表[跳出索引], 代码当前位置(生成器))
      跳出索引 = 跳出索引 + 1
    结束
    生成器["跳出位置"] = 截取(生成器["跳出位置"], 0, 长度(生成器["跳出位置"]) - 1)
    生成器["继续位置"] = 截取(生成器["继续位置"], 0, 长度(生成器["继续位置"]) - 1)
    返回
  结束

  如果 类型 == N_FOR 则
    // 初始化: 变量 = 起始值
    编译节点(生成器, 节点["起始值"])
    让 变量下标 = 代码添加常量(生成器, 节点["变量名"])
    代码发射(生成器, "DEF", 变量下标, 空, 空, 空, 空)
    // 结束值存入临时变量
    编译节点(生成器, 节点["结束值"])
    让 结束变量 = 代码添加常量(生成器, "__结束值__")
    代码发射(生成器, "DEF", 结束变量, 空, 空, 空, 空)
    // 步长
    让 步长值 = 1
    如果 节点["步长"] != 空 则
      如果 节点["步长"]["类型"] == N_NUMBER 则
        步长值 = 节点["步长"]["值"]
      结束
    结束
    让 步长下标 = 代码添加常量(生成器, 步长值)
    让 步长变量 = 代码添加常量(生成器, "__步长__")
    代码发射(生成器, "PUSH", 步长下标, 空, 空, 空, 空)
    代码发射(生成器, "DEF", 步长变量, 空, 空, 空, 空)
    // 条件检查
    让 循环开始 = 代码当前位置(生成器)
    代码发射(生成器, "LOAD", 变量下标, 空, 空, 空, 空)
    代码发射(生成器, "LOAD", 结束变量, 空, 空, 空, 空)
    // 步长为正时 < 结束值，步长为负时 > 结束值
    如果 步长值 >= 0 则
      代码发射(生成器, "LT", 空, 空, 空, 空, 空)
    否则
      代码发射(生成器, "GT", 空, 空, 空, 空, 空)
    结束
    让 退出跳转 = 代码发射(生成器, "JMP_IFNOT", 0, 空, 空, 空, 空)
    // 主体
    添加(生成器["跳出位置"], [])
    添加(生成器["继续位置"], 代码当前位置(生成器))
    让 索引值 = 0
    当 索引值 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引值])
      索引值 = 索引值 + 1
    结束
    // 递增: 变量 += 步长
    代码发射(生成器, "LOAD", 变量下标, 空, 空, 空, 空)
    代码发射(生成器, "LOAD", 步长变量, 空, 空, 空, 空)
    代码发射(生成器, "ADD", 空, 空, 空, 空, 空)
    代码发射(生成器, "STORE", 变量下标, 空, 空, 空, 空)
    代码发射(生成器, "POP", 空, 空, 空, 空, 空)
    代码发射(生成器, "JMP", 循环开始, 空, 空, 空, 空)
    代码修补跳转(生成器, 退出跳转, 代码当前位置(生成器))
    // 修补中断
    让 跳出列表 = 生成器["跳出位置"][长度(生成器["跳出位置"]) - 1]
    让 跳出索引 = 0
    当 跳出索引 < 长度(跳出列表) 时
      代码修补跳转(生成器, 跳出列表[跳出索引], 代码当前位置(生成器))
      跳出索引 = 跳出索引 + 1
    结束
    生成器["跳出位置"] = 截取(生成器["跳出位置"], 0, 长度(生成器["跳出位置"]) - 1)
    生成器["继续位置"] = 截取(生成器["继续位置"], 0, 长度(生成器["继续位置"]) - 1)
    返回
  结束

  如果 类型 == N_FUNCDEF 则
    // 先跳过函数体
    让 跳过跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空)
    让 函数开始 = 代码当前位置(生成器)
    // 编译函数体
    让 索引值 = 0
    当 索引值 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引值])
      索引值 = 索引值 + 1
    结束
    // 隐式返回空
    代码发射(生成器, "PUSH", 代码添加常量(生成器, 空), 空, 空, 空, 空)
    代码发射(生成器, "RET", 空, 空, 空, 空, 空)
    // 修补跳过跳转
    代码修补跳转(生成器, 跳过跳转, 代码当前位置(生成器))
    // 创建函数对象 — 直接构建指令数组（参数数量可变）
    让 名称下标 = 代码添加常量(生成器, 节点["名称"])
    让 参数数量 = 长度(节点["参数列表"])
    让 指令 = ["MAKE_FUNC", 名称下标, 参数数量, 参数数量]
    让 参数索引 = 0
    当 参数索引 < 参数数量 时
      添加(指令, 代码添加常量(生成器, 节点["参数列表"][参数索引]))
      参数索引 = 参数索引 + 1
    结束
    添加(指令, 函数开始)
    添加(生成器["指令"], 指令)
    代码发射(生成器, "POP", 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_RETURN 则
    编译节点(生成器, 节点["值"])
    代码发射(生成器, "RET", 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_BREAK 则
    如果 长度(生成器["跳出位置"]) == 0 则
      错误("'中断' 必须在循环内使用")
    结束
    让 位置 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空)
    添加(生成器["跳出位置"][长度(生成器["跳出位置"]) - 1], 位置)
    返回
  结束

  如果 类型 == N_CONTINUE 则
    如果 长度(生成器["继续位置"]) == 0 则
      错误("'继续' 必须在循环内使用")
    结束
    让 目标 = 生成器["继续位置"][长度(生成器["继续位置"]) - 1]
    代码发射(生成器, "JMP", 目标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_PROGRAM 则
    编译节点(生成器, 节点)
    返回
  结束

  如果 类型 == N_TRYCATCH 则
    让 捕获跳转 = 代码发射(生成器, "TRY", 0, 空, 空, 空, 空)
    // 尝试块
    让 索引值 = 0
    当 索引值 < 长度(节点["尝试块"]) 时
      编译语句(生成器, 节点["尝试块"][索引值])
      索引值 = 索引值 + 1
    结束
    代码发射(生成器, "END_TRY", 空, 空, 空, 空, 空)
    让 结束跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空)
    
    // 捕获块
    代码修补跳转(生成器, 捕获跳转, 代码当前位置(生成器))
    // 捕获块开始时，VM 会压入错误对象，我们需要将其绑定到变量
    如果 节点["变量名"] != 空 则
      让 变量下标 = 代码添加常量(生成器, 节点["变量名"])
      代码发射(生成器, "DEF", 变量下标, 空, 空, 空, 空)
    否则
      代码发射(生成器, "POP", 空, 空, 空, 空, 空)
    结束
    
    索引值 = 0
    当 索引值 < 长度(节点["捕获块"]) 时
      编译语句(生成器, 节点["捕获块"][索引值])
      索引值 = 索引值 + 1
    结束
    
    代码修补跳转(生成器, 结束跳转, 代码当前位置(生成器))
    返回
  结束

  如果 类型 == N_CLASSDEF 则
    // 简化实现：类名 + 方法字典
    让 索引值 = 0
    让 方法数量 = 长度(节点["方法"])
    当 索引值 < 方法数量 时
      编译语句(生成器, 节点["方法"][索引值])
      索引值 = 索引值 + 1
    结束
    // 这里需要构建一个对象包含所有方法，暂简略
    让 类名下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "MAKE_CLASS", 类名下标, 空, 空, 空, 空)
    返回
  结束
结束


// ═══════════════════════════════════════════════════════════════
//  字节码输出 — 生成 .zab JSON
// ═══════════════════════════════════════════════════════════════

函数 序列化JSON值(值)
  // 先检查类型，避免 0 == 假 的问题
  如果 类型(值) == "整数" 或者 类型(值) == "浮点数" 则
    返回 转换文字(值)
  结束
  如果 值 == 空 则 返回 "null" 结束
  如果 值 == 真 则 返回 "true" 结束
  如果 值 == 假 则 返回 "false" 结束
  // 数组
  如果 类型(值) == "数组" 则
    返回 序列化JSON数组(值)
  结束
  // 字符串 — 转义
  让 结果 = "\""
  让 索引值 = 0
  当 索引值 < 长度(值) 时
    让 字符 = 值[索引值]
    如果 字符 == "\"" 则 结果 = 结果 + "\\\""
    否则如果 字符 == "\\" 则 结果 = 结果 + "\\\\"
    否则如果 字符 == "\n" 则 结果 = 结果 + "\\n"
    否则如果 字符 == "\t" 则 结果 = 结果 + "\\t"
    否则 结果 = 结果 + 字符
    结束
    索引值 = 索引值 + 1
  结束
  返回 结果 + "\""
结束

函数 序列化JSON数组(数组)
  让 结果 = "["
  让 索引值 = 0
  当 索引值 < 长度(数组) 时
    如果 索引值 > 0 则 结果 = 结果 + "," 结束
    结果 = 结果 + 序列化JSON值(数组[索引值])
    索引值 = 索引值 + 1
  结束
  返回 结果 + "]"
结束

函数 字节码转JSON(常量池, 指令列表)
  让 结果 = "{\n  \"constants\": "
  结果 = 结果 + 序列化JSON数组(常量池)
  结果 = 结果 + ",\n  \"instructions\": [\n"
  让 索引值 = 0
  当 索引值 < 长度(指令列表) 时
    如果 索引值 > 0 则 结果 = 结果 + ",\n" 结束
    结果 = 结果 + "    " + 序列化JSON数组(指令列表[索引值])
    索引值 = 索引值 + 1
  结束
  结果 = 结果 + "\n  ]\n}"
  返回 结果
结束

函数 转换为整数(值)
  让 结果 = 0
  让 文本 = 转换文字(值)
  让 索引值 = 0
  让 有小数点 = 假
  当 索引值 < 长度(文本) 时
    让 字符 = 文本[索引值]
    如果 字符 == "." 则
      有小数点 = 真
    否则如果 非 有小数点 并且 字符 >= "0" 并且 字符 <= "9" 则
      结果 = 结果 * 10 + (字符码(字符) - 48)
    结束
    索引值 = 索引值 + 1
  结束
  返回 结果
结束


函数 优化字节码(生成器)
  让 原指令 = 生成器["指令"]
  让 新指令 = []
  让 长度值 = 长度(原指令)
  让 索引 = 0
  
  当 索引 < 长度值 时
    让 指令 = 原指令[索引]
    让 操作码 = 指令[0]
    
    // 简单的映射：将通用算术指令转为 BINOP 以减少分发开销
    如果 操作码 == "ADD" 则 添加(新指令, ["BINOP", "+"])
    否则如果 操作码 == "SUB" 则 添加(新指令, ["BINOP", "-"])
    否则如果 操作码 == "MUL" 则 添加(新指令, ["BINOP", "*"])
    否则如果 操作码 == "DIV" 则 添加(新指令, ["BINOP", "/"])
    否则
      添加(新指令, 指令)
    结束
    
    索引 = 索引 + 1
  结束
  
  生成器["指令"] = 新指令
结束

// ═══════════════════════════════════════════════════════════════
//  主入口
// ═══════════════════════════════════════════════════════════════

函数 编译文件(输入文件, 输出文件)
  // 读取源码
  让 源码 = 读文件(输入文件)
  如果 源码 == 空 或者 源码 == "" 则
    错误("无法读取文件: " + 输入文件)
  结束

  // 词法分析
  让 词法分析器 = 新建词法分析器(源码, 输入文件)
  让 词法单元 = 词法生成(词法分析器)

  // 语法分析
  让 语法分析器 = 新建语法分析器(词法单元, 输入文件)
  让 AST = 解析程序(语法分析器)

  // 代码生成
  让 生成器 = 新建代码生成器()
  编译节点(生成器, AST)
  优化字节码(生成器)

  // 输出JSON字节码
  让 JSON输出 = 字节码转JSON(生成器["常量池"], 生成器["指令"])
  写文件(输出文件, JSON输出)

  输出("编译成功: " + 输入文件 + " → " + 输出文件)
  输出("  常量数: " + 转换文字(长度(生成器["常量池"])))
  输出("  指令数: " + 转换文字(长度(生成器["指令"])))
结束

// ─── 执行 ───
让 参数 = 命令行参数()

如果 长度(参数) < 1 则
  输出("致爱编译器 v1.0")
  输出("用法: python -m zhiai compiler/main.za <输入.za> [-o 输出.zab]")
  退出(1)
结束

让 输入文件 = 参数[0]
让 输出文件 = 空

如果 长度(参数) >= 3 并且 参数[1] == "-o" 则
  输出文件 = 参数[2]
否则
  输出文件 = 截取(输入文件, 0, 长度(输入文件) - 3) + ".zab"
结束

输出("致爱编译器 v1.0")
输出("正在编译: " + 输入文件)
编译文件(输入文件, 输出文件)
