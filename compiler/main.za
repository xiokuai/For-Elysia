// ═══════════════════════════════════════════════════════════════
//  致爱自举编译器 — 将 .za 源码编译为 .zab 字节码
//  用法: python -m zhiai compiler/main.za <输入.za> <输出.zab>
// ═══════════════════════════════════════════════════════════════

// ─── Token类型常量 ───
常量 TT_NUMBER = "NUMBER"
常量 TT_STRING = "STRING"
常量 TT_IDENT = "IDENT"
常量 TT_EOF = "EOF"
常量 TT_LET = "LET"
常量 TT_CONST = "CONST"
常量 TT_IF = "IF"
常量 TT_ELIF = "ELIF"
常量 TT_ELSE = "ELSE"
常量 TT_WHILE = "WHILE"
常量 TT_FOR = "FOR"
常量 TT_FROM = "FROM"
常量 TT_TO = "TO"
常量 TT_STEP = "STEP"
常量 TT_EACH = "EACH"
常量 TT_IN = "IN"
常量 TT_MID = "MID"
常量 TT_FUNC = "FUNC"
常量 TT_RETURN = "RETURN"
常量 TT_BREAK = "BREAK"
常量 TT_CONTINUE = "CONTINUE"
常量 TT_TRUE = "TRUE"
常量 TT_FALSE = "FALSE"
常量 TT_NULL = "NULL"
常量 TT_AND = "AND"
常量 TT_OR = "OR"
常量 TT_NOT = "NOT"
常量 TT_TRY = "TRY"
常量 TT_CATCH = "CATCH"
常量 TT_END = "END"
常量 TT_DEFER = "DEFER"
常量 TT_ASYNC = "ASYNC"
常量 TT_AWAIT = "AWAIT"
常量 TT_MATCH = "MATCH"
常量 TT_CASE = "CASE"
常量 TT_QUESTION = "QUESTION"
常量 TT_PLUS = "PLUS"
常量 TT_MINUS = "MINUS"
常量 TT_STAR = "STAR"
常量 TT_SLASH = "SLASH"
常量 TT_PERCENT = "PERCENT"
常量 TT_POWER = "POWER"
常量 TT_EQ = "EQ"
常量 TT_EQEQ = "EQEQ"
常量 TT_NEQ = "NEQ"
常量 TT_LT = "LT"
常量 TT_GT = "GT"
常量 TT_LTE = "LTE"
常量 TT_GTE = "GTE"
常量 TT_NOT_BANG = "NOT_BANG"
常量 TT_AND_AND = "AND_AND"
常量 TT_OR_OR = "OR_OR"
常量 TT_PLUS_EQ = "PLUS_EQ"
常量 TT_MINUS_EQ = "MINUS_EQ"
常量 TT_STAR_EQ = "STAR_EQ"
常量 TT_SLASH_EQ = "SLASH_EQ"
常量 TT_LPAREN = "LPAREN"
常量 TT_RPAREN = "RPAREN"
常量 TT_LBRACKET = "LBRACKET"
常量 TT_RBRACKET = "RBRACKET"
常量 TT_LBRACE = "LBRACE"
常量 TT_RBRACE = "RBRACE"
常量 TT_COMMA = "COMMA"
常量 TT_COLON = "COLON"
常量 TT_DOT = "DOT"

// ─── AST节点类型 ───
常量 N_NUMBER = "NUMBER"
常量 N_STRING = "STRING"
常量 N_BOOL = "BOOL"
常量 N_NULL = "NULL"
常量 N_ARRAY = "ARRAY"
常量 N_OBJECT = "OBJECT"
常量 N_IDENT = "IDENT"
常量 N_UNARY = "UNARY"
常量 N_BINARY = "BINARY"
常量 N_ASSIGN = "ASSIGN"
常量 N_CALL = "CALL"
常量 N_INDEX = "INDEX"
常量 N_PROPACCESS = "PROPACCESS"
常量 N_METHODCALL = "METHODCALL"
常量 N_PROGRAM = "PROGRAM"
常量 N_VARDECL = "VARDECL"
常量 N_CONSTDECL = "CONSTDECL"
常量 N_EXPRSTMT = "EXPRSTMT"
常量 N_IF = "IF"
常量 N_WHILE = "WHILE"
常量 N_FOR = "FOR"
常量 N_FOREACH = "FOREACH"
常量 N_FUNCDEF = "FUNCDEF"
常量 N_RETURN = "RETURN"
常量 N_BREAK = "BREAK"
常量 N_CONTINUE = "CONTINUE"
常量 N_TRYCATCH = "TRYCATCH"
常量 N_CLASSDEF = "CLASSDEF"
常量 N_DEFER = "DEFER"
常量 N_ANONYMOUS = "ANONYMOUS"
常量 N_MATCH = "MATCH"
常量 N_TRY_PROPAGATE = "TRY_PROPAGATE"
常量 N_INTERPOLATED = "INTERPOLATED"


// ═══════════════════════════════════════════════════════════════
//  词法分析器
// ═══════════════════════════════════════════════════════════════

函数 新建词法分析器(源码, 文件名)
  返回 {
    "源码": 源码,
    "位置": 0,
    "行号": 1,
    "列号": 1,
    "文件名": 文件名,
    "关键字": {
      "让": TT_LET, "常量": TT_CONST, "如果": TT_IF,
      "否则如果": TT_ELIF, "否则": TT_ELSE,
      "当": TT_WHILE, "循环": TT_FOR, "对于": TT_FOR,
      "从": TT_FROM, "到": TT_TO, "步长": TT_STEP,
      "每个": TT_EACH, "在": TT_IN, "中": TT_MID,
      "函数": TT_FUNC, "返回": TT_RETURN,
      "中断": TT_BREAK, "继续": TT_CONTINUE,
      "真": TT_TRUE, "假": TT_FALSE, "空": TT_NULL,
      "并且": TT_AND, "或者": TT_OR, "非": TT_NOT,
      "尝试": TT_TRY, "捕获": TT_CATCH, "结束": TT_END,
      "延迟": TT_DEFER, "异步": TT_ASYNC, "等待": TT_AWAIT, "匹配": TT_MATCH, "于": TT_CASE,
      "输出": TT_IDENT, "长度": TT_IDENT, "转换文字": TT_IDENT,
      "读文件": TT_IDENT, "写文件": TT_IDENT, "错误": TT_IDENT,
      "追加文件": TT_IDENT, "文件存在": TT_IDENT
    }
  }
结束

函数 词法当前字符(词法)
  如果 词法["位置"] >= 长度(词法["源码"]) 则
    返回 空
  结束
  返回 词法["源码"][词法["位置"]]
结束

函数 词法前进(词法)
  让 字符 = 词法当前字符(词法)
  如果 字符 == "\n" 则
    词法["行号"] = 词法["行号"] + 1
    词法["列号"] = 1
  否则
    词法["列号"] = 词法["列号"] + 1
  结束
  词法["位置"] = 词法["位置"] + 1
  返回 字符
结束

函数 词法窥探(词法)
  如果 词法["位置"] + 1 >= 长度(词法["源码"]) 则
    返回 空
  结束
  返回 词法["源码"][词法["位置"] + 1]
结束

函数 词法跳过空白和注释(词法)
  当 词法["位置"] < 长度(词法["源码"]) 时
    让 字符 = 词法当前字符(词法)

    // 单行注释 //
    如果 字符 == "/" 并且 词法窥探(词法) == "/" 则
      词法前进(词法)
      词法前进(词法)
      当 词法["位置"] < 长度(词法["源码"]) 并且 词法当前字符(词法) != "\n" 时
        词法前进(词法)
      结束
      继续
    结束

    // 多行注释 /* */
    如果 字符 == "/" 并且 词法窥探(词法) == "*" 则
      词法前进(词法)
      词法前进(词法)
      当 词法["位置"] < 长度(词法["源码"]) 时
        如果 词法当前字符(词法) == "*" 并且 词法窥探(词法) == "/" 则
          词法前进(词法)
          词法前进(词法)
          中断
        结束
        词法前进(词法)
      结束
      继续
    结束

    // 空白字符
    如果 字符 == " " 或者 字符 == "\t" 或者 字符 == "\n" 或者 字符 == "\r" 则
      词法前进(词法)
      继续
    结束

    中断
  结束
结束

函数 词法读取数字(词法)
  让 起始位置 = 词法["位置"]
  让 有小数点 = 假
  当 词法["位置"] < 长度(词法["源码"]) 时
    让 字符 = 词法当前字符(词法)
    如果 字符 >= "0" 并且 字符 <= "9" 则
      词法前进(词法)
    否则如果 字符 == "." 并且 非 有小数点 则
      有小数点 = 真
      词法前进(词法)
    否则
      中断
    结束
  结束
  让 文本 = 截取(词法["源码"], 起始位置, 词法["位置"])
  返回 {"类型": TT_NUMBER, "值": 转换数字(文本), "行号": 词法["行号"]}
结束

函数 词法读取字符串(词法)
  让 引号 = 词法前进(词法)
  让 部分 = []
  当 词法["位置"] < 长度(词法["源码"]) 并且 词法当前字符(词法) != 引号 时
    如果 词法当前字符(词法) == "\\" 则
      词法前进(词法)
      让 转义字符 = 词法前进(词法)
      如果 转义字符 == "n" 则
        添加(部分, "\n")
      否则如果 转义字符 == "t" 则
        添加(部分, "\t")
      否则如果 转义字符 == "\\" 则
        添加(部分, "\\")
      否则如果 转义字符 == "\"" 则
        添加(部分, "\"")
      否则如果 转义字符 == "'" 则
        添加(部分, "'")
      否则
        添加(部分, 转义字符)
      结束
    否则
      添加(部分, 词法前进(词法))
    结束
  结束
  如果 词法["位置"] < 长度(词法["源码"]) 则
    词法前进(词法)  // 跳过结束引号
  结束
  返回 {"类型": TT_STRING, "值": 连接(部分, ""), "行号": 词法["行号"]}
结束

函数 是中文字符(字符)
  让 码 = 字符码(字符)
  返回 (码 >= 19968 并且 码 <= 40959) 或者 (码 >= 12352 并且 码 <= 12543) 或者 (码 >= 65280 并且 码 <= 65519)
结束

函数 是标识符字符(字符)
  如果 字符 >= "a" 并且 字符 <= "z" 则 返回 真 结束
  如果 字符 >= "A" 并且 字符 <= "Z" 则 返回 真 结束
  如果 字符 >= "0" 并且 字符 <= "9" 则 返回 真 结束
  如果 字符 == "_" 则 返回 真 结束
  返回 是中文字符(字符)
结束

函数 词法读取标识符(词法)
  让 起始位置 = 词法["位置"]
  当 词法["位置"] < 长度(词法["源码"]) 并且 是标识符字符(词法当前字符(词法)) 时
    词法前进(词法)
  结束
  让 文本 = 截取(词法["源码"], 起始位置, 词法["位置"])
  让 类型 = TT_IDENT
  如果 对象有键(词法["关键字"], 文本) 则
    类型 = 词法["关键字"][文本]
  结束
  返回 {"类型": 类型, "值": 文本, "行号": 词法["行号"]}
结束

函数 词法生成(词法)
  让 词法单元 = []
  当 词法["位置"] < 长度(词法["源码"]) 时
    词法跳过空白和注释(词法)
    如果 词法["位置"] >= 长度(词法["源码"]) 则
      中断
    结束

    让 字符 = 词法当前字符(词法)
    让 行 = 词法["行号"]

    // 数字
    如果 字符 >= "0" 并且 字符 <= "9" 则
      添加(词法单元, 词法读取数字(词法))
      继续
    结束

    // 字符串 (支持 " 和 ')
    如果 字符 == "\"" 或者 字符 == "'" 则
      添加(词法单元, 词法读取字符串(词法))
      继续
    结束

    // 标识符/关键字
    如果 是标识符字符(字符) 则
      添加(词法单元, 词法读取标识符(词法))
      继续
    结束

    // 双字符运算符
    如果 字符 == "=" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_EQEQ, "值": "==", "行号": 行})
      继续
    结束
    如果 字符 == "!" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_NEQ, "值": "!=", "行号": 行})
      继续
    结束
    如果 字符 == "<" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_LTE, "值": "<=", "行号": 行})
      继续
    结束
    如果 字符 == ">" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_GTE, "值": ">=", "行号": 行})
      继续
    结束
    如果 字符 == "&" 并且 词法窥探(词法) == "&" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_AND_AND, "值": "&&", "行号": 行})
      继续
    结束
    如果 字符 == "|" 并且 词法窥探(词法) == "|" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_OR_OR, "值": "||", "行号": 行})
      继续
    结束
    如果 字符 == "*" 并且 词法窥探(词法) == "*" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_POWER, "值": "**", "行号": 行})
      继续
    结束
    如果 字符 == "+" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_PLUS_EQ, "值": "+=", "行号": 行})
      继续
    结束
    如果 字符 == "-" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_MINUS_EQ, "值": "-=", "行号": 行})
      继续
    结束
    如果 字符 == "*" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_STAR_EQ, "值": "*=", "行号": 行})
      继续
    结束
    如果 字符 == "/" 并且 词法窥探(词法) == "=" 则
      词法前进(词法)
      词法前进(词法)
      添加(词法单元, {"类型": TT_SLASH_EQ, "值": "/=", "行号": 行})
      继续
    结束

    // 单字符运算符
    如果 字符 == "+" 则 词法前进(词法) 添加(词法单元, {"类型": TT_PLUS, "值": "+", "行号": 行}) 继续 结束
    如果 字符 == "-" 则 词法前进(词法) 添加(词法单元, {"类型": TT_MINUS, "值": "-", "行号": 行}) 继续 结束
    如果 字符 == "*" 则 词法前进(词法) 添加(词法单元, {"类型": TT_STAR, "值": "*", "行号": 行}) 继续 结束
    如果 字符 == "/" 则 词法前进(词法) 添加(词法单元, {"类型": TT_SLASH, "值": "/", "行号": 行}) 继续 结束
    如果 字符 == "%" 则 词法前进(词法) 添加(词法单元, {"类型": TT_PERCENT, "值": "%", "行号": 行}) 继续 结束
    如果 字符 == "<" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LT, "值": "<", "行号": 行}) 继续 结束
    如果 字符 == ">" 则 词法前进(词法) 添加(词法单元, {"类型": TT_GT, "值": ">", "行号": 行}) 继续 结束
    如果 字符 == "=" 则 词法前进(词法) 添加(词法单元, {"类型": TT_EQ, "值": "=", "行号": 行}) 继续 结束
    如果 字符 == "!" 则 词法前进(词法) 添加(词法单元, {"类型": TT_NOT_BANG, "值": "!", "行号": 行}) 继续 结束
    如果 字符 == "?" 则 词法前进(词法) 添加(词法单元, {"类型": TT_QUESTION, "值": "?", "行号": 行}) 继续 结束
    如果 字符 == "(" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LPAREN, "值": "(", "行号": 行}) 继续 结束
    如果 字符 == ")" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RPAREN, "值": ")", "行号": 行}) 继续 结束
    如果 字符 == "[" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LBRACKET, "值": "[", "行号": 行}) 继续 结束
    如果 字符 == "]" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RBRACKET, "值": "]", "行号": 行}) 继续 结束
    如果 字符 == "{" 则 词法前进(词法) 添加(词法单元, {"类型": TT_LBRACE, "值": "{", "行号": 行}) 继续 结束
    如果 字符 == "}" 则 词法前进(词法) 添加(词法单元, {"类型": TT_RBRACE, "值": "}", "行号": 行}) 继续 结束
    如果 字符 == "," 则 词法前进(词法) 添加(词法单元, {"类型": TT_COMMA, "值": ",", "行号": 行}) 继续 结束
    如果 字符 == ":" 则 词法前进(词法) 添加(词法单元, {"类型": TT_COLON, "值": ":", "行号": 行}) 继续 结束
    如果 字符 == "." 则 词法前进(词法) 添加(词法单元, {"类型": TT_DOT, "值": ".", "行号": 行}) 继续 结束

    错误(词法["文件名"] + ":" + 转换文字(行) + " 词法错误: 未知字符 '" + 字符 + "'")
  结束
  添加(词法单元, {"类型": TT_EOF, "值": "", "行号": 词法["行号"]})
  返回 词法单元
结束


// ═══════════════════════════════════════════════════════════════
//  语法分析器
// ═══════════════════════════════════════════════════════════════

函数 新建语法分析器(词法单元, 文件名)
  返回 {
    "词法单元": 词法单元,
    "位置": 0,
    "文件名": 文件名
  }
结束

函数 语法当前(解析器)
  返回 解析器["词法单元"][解析器["位置"]]
结束

函数 语法前进(解析器)
  让 当前 = 语法当前(解析器)
  解析器["位置"] = 解析器["位置"] + 1
  返回 当前
结束

函数 语法检查(解析器, 类型)
  返回 语法当前(解析器)["类型"] == 类型
结束

函数 语法期望(解析器, 类型, 消息)
  如果 语法当前(解析器)["类型"] != 类型 则
    让 实际 = 语法当前(解析器)["值"]
    如果 实际 == "" 则 实际 = 语法当前(解析器)["类型"] 结束
    错误(解析器["文件名"] + ":" + 转换文字(语法当前(解析器)["行号"]) + " 语法错误: " + 消息 + "，得到 '" + 实际 + "'")
  结束
  返回 语法前进(解析器)
结束

函数 语法匹配(解析器, 类型)
  如果 语法检查(解析器, 类型) 则
    语法前进(解析器)
    返回 真
  结束
  返回 假
结束

函数 解析程序(解析器)
  让 语句 = []
  当 非 语法检查(解析器, TT_EOF) 时
    添加(语句, 解析语句(解析器))
  结束
  返回 {"类型": N_PROGRAM, "语句": 语句}
结束

函数 解析语句(解析器)
  让 当前类型 = 语法当前(解析器)["类型"]

  如果 当前类型 == TT_LET 则 返回 解析变量声明(解析器) 结束
  如果 当前类型 == TT_CONST 则 返回 解析常量声明(解析器) 结束
  如果 当前类型 == TT_IF 则 返回 解析如果(解析器) 结束
  如果 当前类型 == TT_WHILE 则 返回 解析当循环(解析器) 结束
  如果 当前类型 == TT_FOR 则 返回 解析循环(解析器) 结束
  如果 当前类型 == TT_FUNC 则 返回 解析函数定义(解析器) 结束
  如果 当前类型 == TT_RETURN 则 返回 解析返回(解析器) 结束
  如果 当前类型 == TT_BREAK 则
    语法前进(解析器)
    返回 {"类型": N_BREAK}
  结束
  如果 当前类型 == TT_CONTINUE 则
    语法前进(解析器)
    返回 {"类型": N_CONTINUE}
  结束
  如果 当前类型 == TT_TRY 则 返回 解析尝试捕获(解析器) 结束
  如果 当前类型 == TT_MATCH 则 返回 解析匹配(解析器) 结束
  如果 当前类型 == TT_DEFER 则
    语法前进(解析器)
    让 表达式 = 解析表达式(解析器)
    返回 {"类型": N_DEFER, "表达式": 表达式}
  结束
  如果 当前类型 == TT_IDENT 并且 语法当前(解析器)["值"] == "类" 则 返回 解析类定义(解析器) 结束

  // 表达式语句
  让 表达式 = 解析表达式(解析器)
  // 复合赋值: 标识符 += 表达式
  如果 表达式["类型"] == N_IDENT 则
    如果 语法检查(解析器, TT_PLUS_EQ) 或者 语法检查(解析器, TT_MINUS_EQ) 或者 语法检查(解析器, TT_STAR_EQ) 或者 语法检查(解析器, TT_SLASH_EQ) 则
      让 运算符词法单元 = 语法前进(解析器)
      让 运算符 = "+"
      如果 运算符词法单元["类型"] == TT_MINUS_EQ 则 运算符 = "-" 结束
      如果 运算符词法单元["类型"] == TT_STAR_EQ 则 运算符 = "*" 结束
      如果 运算符词法单元["类型"] == TT_SLASH_EQ 则 运算符 = "/" 结束
      让 右值 = 解析表达式(解析器)
      返回 {"类型": N_ASSIGN, "名称": 表达式["名称"], "值": {"类型": N_BINARY, "运算符": 运算符, "左": 表达式, "右": 右值}}
    结束
    如果 语法检查(解析器, TT_EQ) 则
      语法前进(解析器)
      让 右值 = 解析表达式(解析器)
      返回 {"类型": N_ASSIGN, "名称": 表达式["名称"], "值": 右值}
    结束
  结束
  返回 {"类型": N_EXPRSTMT, "表达式": 表达式}
结束

函数 解析变量声明(解析器)
  语法期望(解析器, TT_LET, "期望 '让'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望变量名")["值"]
  语法期望(解析器, TT_EQ, "期望 '='")
  让 值 = 解析表达式(解析器)
  返回 {"类型": N_VARDECL, "名称": 名称, "值": 值}
结束

函数 解析常量声明(解析器)
  语法期望(解析器, TT_CONST, "期望 '常量'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望常量名")["值"]
  语法期望(解析器, TT_EQ, "期望 '='")
  让 值 = 解析表达式(解析器)
  返回 {"类型": N_CONSTDECL, "名称": 名称, "值": 值}
结束

函数 解析如果主体(解析器)
  // 解析条件和则
  让 条件 = 解析表达式(解析器)
  语法期望(解析器, TT_IDENT, "期望 '则'")  // 则 被识别为标识符
  // 解析真分支
  让 真分支 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_ELSE) 并且 非 语法检查(解析器, TT_ELIF) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(真分支, 解析语句(解析器))
  结束
  // 处理否则如果 / 否则 / 结束
  让 假分支 = []
  如果 语法检查(解析器, TT_ELIF) 则
    语法前进(解析器)  // 消费 否则如果
    让 嵌套 = 解析如果主体(解析器)
    添加(假分支, {"类型": N_IF, "条件": 嵌套["条件"], "真分支": 嵌套["真分支"], "假分支": 嵌套["假分支"]})
  否则如果 语法匹配(解析器, TT_ELSE) 则
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(假分支, 解析语句(解析器))
    结束
  结束
  返回 {"条件": 条件, "真分支": 真分支, "假分支": 假分支}
结束

函数 解析如果(解析器)
  语法期望(解析器, TT_IF, "期望 '如果'")
  让 结果 = 解析如果主体(解析器)
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_IF, "条件": 结果["条件"], "真分支": 结果["真分支"], "假分支": 结果["假分支"]}
结束

函数 解析当循环(解析器)
  语法期望(解析器, TT_WHILE, "期望 '当'")
  让 条件 = 解析表达式(解析器)
  语法期望(解析器, TT_IDENT, "期望 '时'")  // 时 被识别为标识符
  让 主体 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(主体, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_WHILE, "条件": 条件, "主体": 主体}
结束

函数 解析循环(解析器)
  语法期望(解析器, TT_FOR, "期望 '循环' 或 '对于'")

  // 对于 每个 变量 在 数组 中
  如果 语法检查(解析器, TT_EACH) 则
    语法前进(解析器)
    让 变量名 = 语法期望(解析器, TT_IDENT, "期望变量名")["值"]
    语法期望(解析器, TT_IN, "期望 '在'")
    让 可迭代 = 解析表达式(解析器)
    语法期望(解析器, TT_MID, "期望 '中'")
    让 主体 = []
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(主体, 解析语句(解析器))
    结束
    语法期望(解析器, TT_END, "期望 '结束'")
    返回 {"类型": N_FOREACH, "变量名": 变量名, "可迭代": 可迭代, "主体": 主体}
  结束

  // 循环 变量 从 X 到 Y [步长 Z]
  让 变量名 = 语法期望(解析器, TT_IDENT, "期望循环变量名")["值"]
  如果 语法检查(解析器, TT_FROM) 则
    语法前进(解析器)
    让 起始值 = 解析表达式(解析器)
    语法期望(解析器, TT_TO, "期望 '到'")
    让 结束值 = 解析表达式(解析器)
    让 步长值 = 空
    如果 语法匹配(解析器, TT_STEP) 则
      步长值 = 解析表达式(解析器)
    结束
    让 主体 = []
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(主体, 解析语句(解析器))
    结束
    语法期望(解析器, TT_END, "期望 '结束'")
    返回 {"类型": N_FOR, "变量名": 变量名, "起始值": 起始值, "结束值": 结束值, "步长": 步长值, "主体": 主体}
  结束

  错误("循环语法错误")
结束

函数 解析函数定义(解析器)
  语法期望(解析器, TT_FUNC, "期望 '函数'")
  让 名称 = 语法期望(解析器, TT_IDENT, "期望函数名")["值"]
  语法期望(解析器, TT_LPAREN, "期望 '('")
  让 参数列表 = []
  如果 非 语法检查(解析器, TT_RPAREN) 则
    添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
    当 语法匹配(解析器, TT_COMMA) 时
      添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
    结束
  结束
  语法期望(解析器, TT_RPAREN, "期望 ')'")
  让 主体 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(主体, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_FUNCDEF, "名称": 名称, "参数列表": 参数列表, "主体": 主体}
结束

函数 解析尝试捕获(解析器)
  语法期望(解析器, TT_TRY, "期望 '尝试'")
  让 尝试块 = []
  当 非 语法检查(解析器, TT_CATCH) 并且 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(尝试块, 解析语句(解析器))
  结束
  
  让 变量名 = 空
  让 捕获块 = []
  如果 语法匹配(解析器, TT_CATCH) 则
    如果 语法检查(解析器, TT_LPAREN) 则
       语法前进(解析器)
       变量名 = 语法期望(解析器, TT_IDENT, "期望异常变量名")["值"]
       语法期望(解析器, TT_RPAREN, "期望 ')'")
    结束
    当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
      添加(捕获块, 解析语句(解析器))
    结束
  结束
  
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_TRYCATCH, "尝试块": 尝试块, "捕获块": 捕获块, "变量名": 变量名}
结束

函数 解析类定义(解析器)
  语法前进(解析器) // 消费 "类"
  让 名称 = 语法期望(解析器, TT_IDENT, "期望类名")["值"]
  让 方法 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    添加(方法, 解析语句(解析器))
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_CLASSDEF, "名称": 名称, "方法": 方法}
结束

函数 解析返回(解析器)
  语法期望(解析器, TT_RETURN, "期望 '返回'")
  让 值 = 空
  如果 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 并且 非 语法检查(解析器, TT_ELSE) 并且 非 语法检查(解析器, TT_ELIF) 并且 语法当前(解析器)["行号"] == 语法前进(解析器)["行号"] 则
    解析器["位置"] = 解析器["位置"] - 1
    值 = 解析表达式(解析器)
  结束
  如果 值 == 空 则
    值 = {"类型": N_NULL}
  结束
  返回 {"类型": N_RETURN, "值": 值}
结束

函数 解析表达式(解析器)
  返回 解析逻辑或(解析器)
结束

函数 解析逻辑或(解析器)
  让 左 = 解析逻辑与(解析器)
  当 语法检查(解析器, TT_OR) 或者 语法检查(解析器, TT_OR_OR) 时
    语法前进(解析器)
    让 右 = 解析逻辑与(解析器)
    左 = {"类型": N_BINARY, "运算符": "||", "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析逻辑与(解析器)
  让 左 = 解析比较(解析器)
  当 语法检查(解析器, TT_AND) 或者 语法检查(解析器, TT_AND_AND) 时
    语法前进(解析器)
    让 右 = 解析比较(解析器)
    左 = {"类型": N_BINARY, "运算符": "&&", "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析比较(解析器)
  让 左 = 解析加减(解析器)
  当 语法检查(解析器, TT_EQEQ) 或者 语法检查(解析器, TT_NEQ) 或者 语法检查(解析器, TT_LT) 或者 语法检查(解析器, TT_GT) 或者 语法检查(解析器, TT_LTE) 或者 语法检查(解析器, TT_GTE) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析加减(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析加减(解析器)
  让 左 = 解析乘除(解析器)
  当 语法检查(解析器, TT_PLUS) 或者 语法检查(解析器, TT_MINUS) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析乘除(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析乘除(解析器)
  让 左 = 解析幂(解析器)
  当 语法检查(解析器, TT_STAR) 或者 语法检查(解析器, TT_SLASH) 或者 语法检查(解析器, TT_PERCENT) 时
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = 运算符词法单元["值"]
    让 右 = 解析幂(解析器)
    左 = {"类型": N_BINARY, "运算符": 运算符, "左": 左, "右": 右}
  结束
  返回 左
结束

函数 解析幂(解析器)
  让 左 = 解析一元(解析器)
  如果 语法检查(解析器, TT_POWER) 则
    语法前进(解析器)
    让 右 = 解析一元(解析器)
    左 = {"类型": N_BINARY, "运算符": "**", "左": 左, "右": 右}
  结束
  返回 左
结束


函数 解析匹配(解析器)
  语法期望(解析器, TT_MATCH, "期望 '匹配'")
  让 目标 = 解析表达式(解析器)
  语法期望(解析器, TT_CASE, "期望 '于'")
  让 分支列表 = []
  让 默认分支 = 空
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
    如果 语法检查(解析器, TT_ELSE) 则
      语法前进(解析器)
      如果 语法检查(解析器, TT_COLON) 则 语法前进(解析器) 结束
      默认分支 = 解析分支主体(解析器)
      中断
    结束
    让 模式 = 解析表达式(解析器)
    语法期望(解析器, TT_COLON, "期望 ':'")
    让 主体 = 解析分支主体(解析器)
    添加(分支列表, {"模式": 模式, "主体": 主体})
  结束
  语法期望(解析器, TT_END, "期望 '结束'")
  返回 {"类型": N_MATCH, "目标": 目标, "分支": 分支列表, "默认分支": 默认分支}
结束

函数 解析分支主体(解析器)
  让 语句 = []
  当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_ELIF) 并且 非 语法检查(解析器, TT_ELSE) 并且 非 语法检查(解析器, TT_CATCH) 并且 非 语法检查(解析器, TT_EOF) 时
    如果 解析器["位置"] + 1 < 长度(解析器["词法单元"]) 并且 解析器["词法单元"][解析器["位置"] + 1]["类型"] == TT_COLON 则
      如果 语法检查(解析器, TT_ELSE) 则
        // 继续
      否则
        中断
      结束
    结束
    如果 语法检查(解析器, TT_ELSE) 则 中断 结束
    添加(语句, 解析语句(解析器))
  结束
  返回 语句
结束

函数 解析一元(解析器)
  如果 语法检查(解析器, TT_MINUS) 或者 语法检查(解析器, TT_NOT) 或者 语法检查(解析器, TT_NOT_BANG) 则
    让 运算符词法单元 = 语法前进(解析器)
    让 运算符 = "-"
    如果 运算符词法单元["类型"] == TT_NOT 或者 运算符词法单元["类型"] == TT_NOT_BANG 则
      运算符 = "!"
    结束
    让 操作数 = 解析一元(解析器)
    返回 {"类型": N_UNARY, "运算符": 运算符, "操作数": 操作数}
  结束
  让 表达式 = 解析调用链(解析器)
  当 语法匹配(解析器, TT_QUESTION) 时
    表达式 = {"类型": N_TRY_PROPAGATE, "表达式": 表达式}
  结束
  返回 表达式
结束

函数 解析调用链(解析器)
  让 节点 = 解析原子(解析器)
  当 真 时
    // 函数调用: 标识符(...)
    如果 语法检查(解析器, TT_LPAREN) 则
      语法前进(解析器)
      让 参数列表 = []
      如果 非 语法检查(解析器, TT_RPAREN) 则
        添加(参数列表, 解析表达式(解析器))
        当 语法匹配(解析器, TT_COMMA) 时
          添加(参数列表, 解析表达式(解析器))
        结束
      结束
      语法期望(解析器, TT_RPAREN, "期望 ')'")
      节点 = {"类型": N_CALL, "函数": 节点, "参数列表": 参数列表}
      继续
    结束

    // 索引访问: 标识符[索引]
    如果 语法检查(解析器, TT_LBRACKET) 则
      语法前进(解析器)
      让 索引 = 解析表达式(解析器)
      语法期望(解析器, TT_RBRACKET, "期望 ']'")
      // 索引赋值检查
      如果 语法检查(解析器, TT_EQ) 则
        语法前进(解析器)
        让 值 = 解析表达式(解析器)
        返回 {"类型": N_ASSIGN, "名称": 空, "索引": {"对象": 节点, "索引": 索引}, "值": 值}
      结束
      节点 = {"类型": N_INDEX, "对象": 节点, "索引": 索引}
      继续
    结束

    // 属性访问: 标识符.属性
    如果 语法检查(解析器, TT_DOT) 则
      语法前进(解析器)
      让 属性名 = 语法期望(解析器, TT_IDENT, "期望属性名")["值"]
      // 属性赋值检查
      如果 语法检查(解析器, TT_EQ) 则
        语法前进(解析器)
        让 值 = 解析表达式(解析器)
        返回 {"类型": N_ASSIGN, "名称": 空, "属性": {"对象": 节点, "属性": 属性名}, "值": 值}
      结束
      // 方法调用检查: 对象.方法(参数)
      如果 语法检查(解析器, TT_LPAREN) 则
        语法前进(解析器)
        让 参数列表 = []
        如果 非 语法检查(解析器, TT_RPAREN) 则
          添加(参数列表, 解析表达式(解析器))
          当 语法匹配(解析器, TT_COMMA) 时
            添加(参数列表, 解析表达式(解析器))
          结束
        结束
        语法期望(解析器, TT_RPAREN, "期望 ')'")
        节点 = {"类型": N_METHODCALL, "对象": 节点, "方法": 属性名, "参数列表": 参数列表}
      否则
        节点 = {"类型": N_PROPACCESS, "对象": 节点, "属性": 属性名}
      结束
      继续
    结束

    中断
  结束
  返回 节点
结束

函数 解析原子(解析器)
  让 当前 = 语法当前(解析器)

  // 数字
  如果 当前["类型"] == TT_NUMBER 则
    语法前进(解析器)
    返回 {"类型": N_NUMBER, "值": 当前["值"]}
  结束


  // 字符串
  如果 当前["类型"] == TT_STRING 则
    语法前进(解析器)
    让 文本 = 当前["值"]
    // 简易插值检查 (暂时只支持简单的单变量插值，如 "你好 {名字}")
    让 有括号 = 假
    让 索引值 = 0
    当 索引值 < 长度(文本) 时
      如果 文本[索引值] == "{" 则 有括号 = 真 中断 结束
      索引值 = 索引值 + 1
    结束
    
    如果 有括号 则
      让 片段 = []
      让 文本缓冲 = ""
      让 处于表达式 = 假
      让 表达式缓冲 = ""
      索引值 = 0
      当 索引值 < 长度(文本) 时
        让 字符 = 文本[索引值]
        如果 处于表达式 则
          如果 字符 == "}" 则
            处于表达式 = 假
            // 简单处理: 假定括号内是一个标识符
            添加(片段, {"类型": N_IDENT, "名称": 表达式缓冲})
            表达式缓冲 = ""
          否则
            表达式缓冲 = 表达式缓冲 + 字符
          结束
        否则
          如果 字符 == "{" 则
            如果 文本缓冲 != "" 则
              添加(片段, {"类型": N_STRING, "值": 文本缓冲})
              文本缓冲 = ""
            结束
            处于表达式 = 真
          否则
            文本缓冲 = 文本缓冲 + 字符
          结束
        结束
        索引值 = 索引值 + 1
      结束
      如果 文本缓冲 != "" 则
        添加(片段, {"类型": N_STRING, "值": 文本缓冲})
      结束
      返回 {"类型": N_INTERPOLATED, "片段": 片段}
    结束

    返回 {"类型": N_STRING, "值": 文本}
  结束

  // 布尔
  如果 当前["类型"] == TT_TRUE 则
    语法前进(解析器)
    返回 {"类型": N_BOOL, "值": 真}
  结束
  如果 当前["类型"] == TT_FALSE 则
    语法前进(解析器)
    返回 {"类型": N_BOOL, "值": 假}
  结束

  // 空
  如果 当前["类型"] == TT_NULL 则
    语法前进(解析器)
    返回 {"类型": N_NULL}
  结束

  // 标识符
  如果 当前["类型"] == TT_IDENT 则
    语法前进(解析器)
    返回 {"类型": N_IDENT, "名称": 当前["值"]}
  结束

  // 匿名函数
  如果 当前["类型"] == TT_FUNC 则
    语法前进(解析器)
    语法期望(解析器, TT_LPAREN, "期望 '('")
    让 参数列表 = []
    如果 非 语法检查(解析器, TT_RPAREN) 则
      添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
      当 语法匹配(解析器, TT_COMMA) 时
        添加(参数列表, 语法期望(解析器, TT_IDENT, "期望参数名")["值"])
      结束
    结束
    语法期望(解析器, TT_RPAREN, "期望 ')'")
    
    让 主体 = []
    如果 语法当前(解析器)["类型"] == TT_RETURN 则
      语法前进(解析器)
      让 表达式 = 解析表达式(解析器)
      语法期望(解析器, TT_END, "期望 '结束'")
      主体 = [{"类型": N_RETURN, "值": 表达式}]
    否则
      当 非 语法检查(解析器, TT_END) 并且 非 语法检查(解析器, TT_EOF) 时
        添加(主体, 解析语句(解析器))
      结束
      语法期望(解析器, TT_END, "期望 '结束'")
    结束
    返回 {"类型": N_ANONYMOUS, "参数列表": 参数列表, "主体": 主体}
  结束

  // 括号表达式
  如果 当前["类型"] == TT_LPAREN 则
    语法前进(解析器)
    让 表达式 = 解析表达式(解析器)
    语法期望(解析器, TT_RPAREN, "期望 ')'")
    返回 表达式
  结束

  // 数组字面量
  如果 当前["类型"] == TT_LBRACKET 则
    语法前进(解析器)
    让 元素 = []
    如果 非 语法检查(解析器, TT_RBRACKET) 则
      添加(元素, 解析表达式(解析器))
      当 语法匹配(解析器, TT_COMMA) 时
        添加(元素, 解析表达式(解析器))
      结束
    结束
    语法期望(解析器, TT_RBRACKET, "期望 ']'")
    返回 {"类型": N_ARRAY, "元素": 元素}
  结束

  // 对象字面量
  如果 当前["类型"] == TT_LBRACE 则
    语法前进(解析器)
    让 键值对 = []
    如果 非 语法检查(解析器, TT_RBRACE) 则
      让 键 = 语法期望(解析器, TT_STRING, "期望字符串键")["值"]
      语法期望(解析器, TT_COLON, "期望 ':'")
      让 值 = 解析表达式(解析器)
      添加(键值对, {"键": 键, "值": 值})
      当 语法匹配(解析器, TT_COMMA) 时
        键 = 语法期望(解析器, TT_STRING, "期望字符串键")["值"]
        语法期望(解析器, TT_COLON, "期望 ':'")
        值 = 解析表达式(解析器)
        添加(键值对, {"键": 键, "值": 值})
      结束
    结束
    语法期望(解析器, TT_RBRACE, "期望 '}'")
    返回 {"类型": N_OBJECT, "键值对": 键值对}
  结束

  错误(解析器["文件名"] + ":" + 转换文字(当前["行号"]) + " 语法错误: 期望表达式，得到 '" + 当前["值"] + "'")
结束


// ═══════════════════════════════════════════════════════════════
//  基于寄存器的字节码代码生成器
// ═══════════════════════════════════════════════════════════════

函数 新建代码生成器()
  返回 {
    "常量池": [],
    "指令": [],
    "跳出位置": [],
    "继续位置": [],
    "处于函数": 假,
    "局部变量": [], 
    "可用寄存器": 0
  }
结束

函数 分配寄存器(生成器)
  让 r = 生成器["可用寄存器"]
  生成器["可用寄存器"] = r + 1
  返回 r
结束

函数 释放寄存器(生成器, r)
  如果 r == 生成器["可用寄存器"] - 1 则
    生成器["可用寄存器"] = r
  结束
结束

函数 查找局部变量(生成器, 变量名)
  让 列表 = 生成器["局部变量"]
  让 索引 = 长度(列表) - 1
  当 索引 >= 0 时
    如果 列表[索引]["名称"] == 变量名 则
      返回 列表[索引]["寄存器"]
    结束
    索引 = 索引 - 1
  结束
  返回 -1
结束

函数 定义局部变量(生成器, 变量名, 寄存器)
  添加(生成器["局部变量"], {"名称": 变量名, "寄存器": 寄存器})
结束

函数 代码发射(生成器, 操作码, 参数1, 参数2, 参数3, 参数4, 参数5, 参数6)
  让 指令 = [操作码]
  如果 参数1 != 空 则 添加(指令, 参数1) 结束
  如果 参数2 != 空 则 添加(指令, 参数2) 结束
  如果 参数3 != 空 则 添加(指令, 参数3) 结束
  如果 参数4 != 空 则 添加(指令, 参数4) 结束
  如果 参数5 != 空 则 添加(指令, 参数5) 结束
  如果 参数6 != 空 则 添加(指令, 参数6) 结束
  添加(生成器["指令"], 指令)
  返回 长度(生成器["指令"]) - 1
结束

函数 代码添加常量(生成器, 值)
  让 池 = 生成器["常量池"]
  让 索引值 = 0
  当 索引值 < 长度(池) 时
    如果 类型(池[索引值]) == 类型(值) 并且 池[索引值] == 值 则
      返回 索引值
    结束
    索引值 = 索引值 + 1
  结束
  添加(池, 值)
  返回 长度(池) - 1
结束

函数 代码当前位置(生成器)
  返回 长度(生成器["指令"])
结束

函数 代码修补跳转(生成器, 指令位置, 目标位置)
  如果 生成器["指令"][指令位置][0] == "JMP" 则
    生成器["指令"][指令位置] = ["JMP", 目标位置]
  否则
    生成器["指令"][指令位置] = [生成器["指令"][指令位置][0], 生成器["指令"][指令位置][1], 目标位置]
  结束
结束

函数 编译节点(生成器, 节点, 目标寄存器)
  让 类型 = 节点["类型"]

  如果 类型 == N_NUMBER 或者 类型 == N_STRING 则
    让 下标 = 代码添加常量(生成器, 节点["值"])
    代码发射(生成器, "LOAD_CONST", 目标寄存器, 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_BOOL 则
    如果 节点["值"] 则 代码发射(生成器, "LOAD_BOOL", 目标寄存器, 1, 空, 空, 空, 空)
    否则 代码发射(生成器, "LOAD_BOOL", 目标寄存器, 0, 空, 空, 空, 空) 结束
    返回
  结束

  如果 类型 == N_NULL 则
    代码发射(生成器, "LOAD_NULL", 目标寄存器, 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_IDENT 则
    如果 生成器["处于函数"] 则
      让 局存 = 查找局部变量(生成器, 节点["名称"])
      如果 局存 != -1 则
        代码发射(生成器, "MOVE", 目标寄存器, 局存, 空, 空, 空, 空)
        返回
      结束
    结束
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "LOAD_GLOBAL", 目标寄存器, 下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_BINARY 则
    让 左寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["左"], 左寄存器)
    让 右寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["右"], 右寄存器)
    让 运算符 = 节点["运算符"]
    让 映射 = {"+": "ADD", "-": "SUB", "*": "MUL", "/": "DIV", "%": "MOD", "**": "POW", "==": "EQ", "!=": "NEQ", "<": "LT", ">": "GT", "<=": "LTE", ">=": "GTE", "&&": "AND", "||": "OR"}
    如果 对象有键(映射, 运算符) 则
      代码发射(生成器, 映射[运算符], 目标寄存器, 左寄存器, 右寄存器, 空, 空, 空)
    否则 错误("未知二元运算符: " + 运算符) 结束
    释放寄存器(生成器, 右寄存器)
    释放寄存器(生成器, 左寄存器)
    返回
  结束

  如果 类型 == N_UNARY 则
    让 操作数寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["操作数"], 操作数寄存器)
    如果 节点["运算符"] == "-" 则 代码发射(生成器, "NEG", 目标寄存器, 操作数寄存器, 空, 空, 空, 空)
    否则 代码发射(生成器, "NOT", 目标寄存器, 操作数寄存器, 空, 空, 空, 空) 结束
    释放寄存器(生成器, 操作数寄存器)
    返回
  结束

  如果 类型 == N_CALL 则
    让 函数寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["函数"], 函数寄存器)
    让 参数列表 = 节点["参数列表"]
    让 参数数 = 长度(参数列表)
    让 参数起始 = 生成器["可用寄存器"]
    让 索引 = 0
    当 索引 < 参数数 时
      让 参存 = 分配寄存器(生成器)
      编译节点(生成器, 参数列表[索引], 参存)
      索引 = 索引 + 1
    结束
    代码发射(生成器, "CALL", 目标寄存器, 函数寄存器, 参数起始, 参数数, 空, 空)
    生成器["可用寄存器"] = 参数起始
    释放寄存器(生成器, 函数寄存器)
    返回
  结束

  如果 类型 == N_METHODCALL 则
    让 对象寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["对象"], 对象寄存器)
    让 方法下标 = 代码添加常量(生成器, 节点["方法"])
    让 参数列表 = 节点["参数列表"]
    让 参数数 = 长度(参数列表)
    让 参数起始 = 生成器["可用寄存器"]
    让 索引 = 0
    当 索引 < 参数数 时
      让 参存 = 分配寄存器(生成器)
      编译节点(生成器, 参数列表[索引], 参存)
      索引 = 索引 + 1
    结束
    代码发射(生成器, "CALL_METHOD", 目标寄存器, 对象寄存器, 方法下标, 参数起始, 参数数, 空)
    生成器["可用寄存器"] = 参数起始
    释放寄存器(生成器, 对象寄存器)
    返回
  结束

  如果 类型 == N_ASSIGN 则
    如果 对象有键(节点, "索引") 并且 节点["索引"] != 空 则
      让 对象寄存器 = 分配寄存器(生成器)
      编译节点(生成器, 节点["索引"]["对象"], 对象寄存器)
      让 索引寄存器 = 分配寄存器(生成器)
      编译节点(生成器, 节点["索引"]["索引"], 索引寄存器)
      编译节点(生成器, 节点["值"], 目标寄存器)
      代码发射(生成器, "STORE_INDEX", 对象寄存器, 索引寄存器, 目标寄存器, 空, 空, 空)
      释放寄存器(生成器, 索引寄存器)
      释放寄存器(生成器, 对象寄存器)
      返回
    结束
    如果 对象有键(节点, "属性") 并且 节点["属性"] != 空 则
      让 对象寄存器 = 分配寄存器(生成器)
      编译节点(生成器, 节点["属性"]["对象"], 对象寄存器)
      编译节点(生成器, 节点["值"], 目标寄存器)
      让 下标 = 代码添加常量(生成器, 节点["属性"]["属性"])
      代码发射(生成器, "STORE_PROP", 对象寄存器, 下标, 目标寄存器, 空, 空, 空)
      释放寄存器(生成器, 对象寄存器)
      返回
    结束
    编译节点(生成器, 节点["值"], 目标寄存器)
    如果 生成器["处于函数"] 则
      让 局存 = 查找局部变量(生成器, 节点["名称"])
      如果 局存 != -1 则
        代码发射(生成器, "MOVE", 局存, 目标寄存器, 空, 空, 空, 空)
        返回
      结束
    结束
    让 下标 = 代码添加常量(生成器, 节点["名称"])
    代码发射(生成器, "STORE_GLOBAL", 下标, 目标寄存器, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_PROPACCESS 则
    让 对象寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["对象"], 对象寄存器)
    让 下标 = 代码添加常量(生成器, 节点["属性"])
    代码发射(生成器, "LOAD_PROP", 目标寄存器, 对象寄存器, 下标, 空, 空, 空)
    释放寄存器(生成器, 对象寄存器)
    返回
  结束

  如果 类型 == N_INDEX 则
    让 对象寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["对象"], 对象寄存器)
    让 索引寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["索引"], 索引寄存器)
    代码发射(生成器, "LOAD_INDEX", 目标寄存器, 对象寄存器, 索引寄存器, 空, 空, 空)
    释放寄存器(生成器, 索引寄存器)
    释放寄存器(生成器, 对象寄存器)
    返回
  结束

  如果 类型 == N_ARRAY 则
    让 元素数 = 长度(节点["元素"])
    让 元素起始 = 生成器["可用寄存器"]
    让 索引 = 0
    当 索引 < 元素数 时
      让 元存 = 分配寄存器(生成器)
      编译节点(生成器, 节点["元素"][索引], 元存)
      索引 = 索引 + 1
    结束
    代码发射(生成器, "MAKE_ARRAY", 目标寄存器, 元素起始, 元素数, 空, 空, 空)
    生成器["可用寄存器"] = 元素起始
    返回
  结束

  如果 类型 == N_OBJECT 则
    让 对数 = 长度(节点["键值对"])
    让 对起始 = 生成器["可用寄存器"]
    让 索引 = 0
    当 索引 < 对数 时
      让 键存 = 分配寄存器(生成器)
      让 下标 = 代码添加常量(生成器, 节点["键值对"][索引]["键"])
      代码发射(生成器, "LOAD_CONST", 键存, 下标, 空, 空, 空, 空)
      让 值存 = 分配寄存器(生成器)
      编译节点(生成器, 节点["键值对"][索引]["值"], 值存)
      索引 = 索引 + 1
    结束
    代码发射(生成器, "MAKE_OBJECT", 目标寄存器, 对起始, 对数, 空, 空, 空)
    生成器["可用寄存器"] = 对起始
    返回
  结束

  如果 类型 == N_ANONYMOUS 则
    让 匿名函数名 = "__匿名_" + 转换文字(代码当前位置(生成器)) + "__"
    让 伪函数节点 = {"类型": N_FUNCDEF, "名称": 匿名函数名, "参数列表": 节点["参数列表"], "主体": 节点["主体"]}
    编译语句(生成器, 伪函数节点)
    让 函数名下标 = 代码添加常量(生成器, 匿名函数名)
    代码发射(生成器, "LOAD_GLOBAL", 目标寄存器, 函数名下标, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_TRY_PROPAGATE 则
    编译节点(生成器, 节点["表达式"], 目标寄存器)
    代码发射(生成器, "TRY_PROPAGATE", 目标寄存器, 目标寄存器, 空, 空, 空, 空)
    返回
  结束
  
  如果 类型 == N_INTERPOLATED 则
    如果 长度(节点["片段"]) == 0 则
      代码发射(生成器, "LOAD_CONST", 目标寄存器, 代码添加常量(生成器, ""), 空, 空, 空, 空)
      返回
    结束
    编译节点(生成器, 节点["片段"][0], 目标寄存器)
    让 索引值 = 1
    当 索引值 < 长度(节点["片段"]) 时
      让 临时存 = 分配寄存器(生成器)
      编译节点(生成器, 节点["片段"][索引值], 临时存)
      让 函数存 = 分配寄存器(生成器)
      代码发射(生成器, "LOAD_GLOBAL", 函数存, 代码添加常量(生成器, "转换文字"), 空, 空, 空, 空)
      代码发射(生成器, "CALL", 临时存, 函数存, 临时存, 1, 空, 空)
      释放寄存器(生成器, 函数存)
      函数存 = 分配寄存器(生成器)
      代码发射(生成器, "LOAD_GLOBAL", 函数存, 代码添加常量(生成器, "转换文字"), 空, 空, 空, 空)
      代码发射(生成器, "CALL", 目标寄存器, 函数存, 目标寄存器, 1, 空, 空)
      释放寄存器(生成器, 函数存)
      代码发射(生成器, "ADD", 目标寄存器, 目标寄存器, 临时存, 空, 空, 空)
      释放寄存器(生成器, 临时存)
      索引值 = 索引值 + 1
    结束
    返回
  结束

  如果 类型 == N_PROGRAM 则
    编译语句(生成器, 节点)
    返回
  结束

  错误("不支持编译表达式节点: " + 类型)
结束

函数 编译语句(生成器, 节点)
  让 类型 = 节点["类型"]

  如果 类型 == N_VARDECL 或者 类型 == N_CONSTDECL 则
    让 目标寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["值"], 目标寄存器)
    如果 生成器["处于函数"] 则
      定义局部变量(生成器, 节点["名称"], 目标寄存器)
    否则
      代码发射(生成器, "DEF_GLOBAL", 代码添加常量(生成器, 节点["名称"]), 目标寄存器, 空, 空, 空, 空)
      释放寄存器(生成器, 目标寄存器)
    结束
    返回
  结束

  如果 类型 == N_EXPRSTMT 则
    让 临时寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["表达式"], 临时寄存器)
    释放寄存器(生成器, 临时寄存器)
    返回
  结束

  如果 类型 == N_ASSIGN 则
    让 临时寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点, 临时寄存器)
    释放寄存器(生成器, 临时寄存器)
    返回
  结束

  如果 类型 == N_IF 则
    让 条件存 = 分配寄存器(生成器)
    编译节点(生成器, 节点["条件"], 条件存)
    让 假跳过 = 代码发射(生成器, "JMP_IFNOT", 条件存, 0, 空, 空, 空, 空)
    释放寄存器(生成器, 条件存)
    让 索引 = 0
    当 索引 < 长度(节点["真分支"]) 时
      编译语句(生成器, 节点["真分支"][索引])
      索引 = 索引 + 1
    结束
    让 结束跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空)
    代码修补跳转(生成器, 假跳过, 代码当前位置(生成器))
    索引 = 0
    当 索引 < 长度(节点["假分支"]) 时
      编译语句(生成器, 节点["假分支"][索引])
      索引 = 索引 + 1
    结束
    代码修补跳转(生成器, 结束跳转, 代码当前位置(生成器))
    返回
  结束

  如果 类型 == N_WHILE 则
    让 循环开始 = 代码当前位置(生成器)
    让 条件存 = 分配寄存器(生成器)
    编译节点(生成器, 节点["条件"], 条件存)
    让 退出跳转 = 代码发射(生成器, "JMP_IFNOT", 条件存, 0, 空, 空, 空, 空)
    释放寄存器(生成器, 条件存)
    
    // 跳出/继续处理
    添加(生成器["跳出位置"], [])
    添加(生成器["继续位置"], 循环开始)
    
    让 索引 = 0
    当 索引 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引])
      索引 = 索引 + 1
    结束
    代码发射(生成器, "JMP", 循环开始, 空, 空, 空, 空, 空)
    代码修补跳转(生成器, 退出跳转, 代码当前位置(生成器))
    
    让 跳出列表 = 生成器["跳出位置"][长度(生成器["跳出位置"]) - 1]
    让 跳出索引 = 0
    当 跳出索引 < 长度(跳出列表) 时
      代码修补跳转(生成器, 跳出列表[跳出索引], 代码当前位置(生成器))
      跳出索引 = 跳出索引 + 1
    结束
    生成器["跳出位置"] = 截取(生成器["跳出位置"], 0, 长度(生成器["跳出位置"]) - 1)
    生成器["继续位置"] = 截取(生成器["继续位置"], 0, 长度(生成器["继续位置"]) - 1)
    返回
  结束

  如果 类型 == N_FOR 则
    // 循环 变量 从 X 到 Y [步长 Z]
    // 转换为 WHILE 结构
    让 变量寄存器 = 分配寄存器(生成器)
    编译节点(生成器, 节点["起始值"], 变量寄存器)
    定义局部变量(生成器, 节点["变量名"], 变量寄存器)
    
    让 结束值存 = 分配寄存器(生成器)
    编译节点(生成器, 节点["结束值"], 结束值存)
    
    让 步长存 = 分配寄存器(生成器)
    如果 节点["步长"] != 空 则
      编译节点(生成器, 节点["步长"], 步长存)
    否则
      代码发射(生成器, "LOAD_CONST", 步长存, 代码添加常量(生成器, 1), 空, 空, 空, 空)
    结束
    
    让 循环开始 = 代码当前位置(生成器)
    让 条件存 = 分配寄存器(生成器)
    // 简单假定步长为正: 变量 <= 结束值
    代码发射(生成器, "LTE", 条件存, 变量寄存器, 结束值存, 空, 空, 空)
    让 退出跳转 = 代码发射(生成器, "JMP_IFNOT", 条件存, 0, 空, 空, 空, 空)
    释放寄存器(生成器, 条件存)
    
    添加(生成器["跳出位置"], [])
    // 继续位置应该是步长增加的地方
    让 步增跳转占位 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空)
    让 步增位置 = 代码当前位置(生成器)
    代码发射(生成器, "ADD", 变量寄存器, 变量寄存器, 步长存, 空, 空, 空)
    代码发射(生成器, "JMP", 循环开始, 空, 空, 空, 空, 空)
    代码修补跳转(生成器, 步增跳转占位, 代码当前位置(生成器))
    
    添加(生成器["继续位置"], 步增位置)
    
    让 索引 = 0
    当 索引 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引])
      索引 = 索引 + 1
    结束
    
    代码发射(生成器, "JMP", 步增位置, 空, 空, 空, 空, 空)
    代码修补跳转(生成器, 退出跳转, 代码当前位置(生成器))
    
    让 跳出列表 = 生成器["跳出位置"][长度(生成器["跳出位置"]) - 1]
    让 跳出索引 = 0
    当 跳出索引 < 长度(跳出列表) 时
      代码修补跳转(生成器, 跳出列表[跳出索引], 代码当前位置(生成器))
      跳出索引 = 跳出索引 + 1
    结束
    生成器["跳出位置"] = 截取(生成器["跳出位置"], 0, 长度(生成器["跳出位置"]) - 1)
    生成器["继续位置"] = 截取(生成器["继续位置"], 0, 长度(生成器["继续位置"]) - 1)
    返回
  结束

  如果 类型 == N_FOREACH 则
    // TODO: FOREACH
    返回
  结束

  如果 类型 == N_RETURN 则
    让 值存 = 分配寄存器(生成器)
    如果 节点["值"] != 空 则
      编译节点(生成器, 节点["值"], 值存)
    否则
      代码发射(生成器, "LOAD_NULL", 值存, 空, 空, 空, 空, 空)
    结束
    代码发射(生成器, "RET", 值存, 空, 空, 空, 空, 空)
    释放寄存器(生成器, 值存)
    返回
  结束
  
  如果 类型 == N_FUNCDEF 则
    让 旧处于函数 = 生成器["处于函数"]
    让 旧局部变量 = 生成器["局部变量"]
    让 旧可用 = 生成器["可用寄存器"]
    生成器["处于函数"] = 真
    生成器["局部变量"] = []
    生成器["可用寄存器"] = 0
    
    让 参数数 = 长度(节点["参数列表"])
    让 索引 = 0
    当 索引 < 参数数 时
      // 参数进入时就在寄存器 0, 1, 2...
      定义局部变量(生成器, 节点["参数列表"][索引], 分配寄存器(生成器))
      索引 = 索引 + 1
    结束
    
    让 跳过跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空)
    让 函数开始 = 代码当前位置(生成器)
    
    索引 = 0
    当 索引 < 长度(节点["主体"]) 时
      编译语句(生成器, 节点["主体"][索引])
      索引 = 索引 + 1
    结束
    
    让 空存 = 分配寄存器(生成器)
    代码发射(生成器, "LOAD_NULL", 空存, 空, 空, 空, 空, 空)
    代码发射(生成器, "RET", 空存, 空, 空, 空, 空, 空)
    释放寄存器(生成器, 空存)
    
    代码修补跳转(生成器, 跳过跳转, 代码当前位置(生成器))
    
    生成器["处于函数"] = 旧处于函数
    生成器["局部变量"] = 旧局部变量
    生成器["可用寄存器"] = 旧可用
    
    让 参数名起始 = 生成器["可用寄存器"]
    索引 = 0
    当 索引 < 参数数 时
      代码发射(生成器, "LOAD_CONST", 分配寄存器(生成器), 代码添加常量(生成器, 节点["参数列表"][索引]), 空, 空, 空, 空)
      索引 = 索引 + 1
    结束
    
    让 临时存 = 分配寄存器(生成器)
    代码发射(生成器, "MAKE_FUNC", 临时存, 代码添加常量(生成器, 节点["名称"]), 参数数, 参数数, 参数名起始, 函数开始)
    代码发射(生成器, "DEF_GLOBAL", 代码添加常量(生成器, 节点["名称"]), 临时存, 空, 空, 空, 空)
    
    生成器["可用寄存器"] = 参数名起始
    返回
  结束

  如果 类型 == N_MATCH 则
    让 目标存 = 分配寄存器(生成器)
    编译节点(生成器, 节点["目标"], 目标存)
    让 分支数 = 长度(节点["分支"])
    让 结束跳转列表 = []
    让 索引 = 0
    让 下一个假跳过 = 空
    当 索引 < 分支数 时
      如果 下一个假跳过 != 空 则
        代码修补跳转(生成器, 下一个假跳过, 代码当前位置(生成器))
      结束
      让 模式存 = 分配寄存器(生成器)
      编译节点(生成器, 节点["分支"][索引]["模式"], 模式存)
      让 比较存 = 分配寄存器(生成器)
      代码发射(生成器, "EQ", 比较存, 目标存, 模式存, 空, 空, 空)
      下一个假跳过 = 代码发射(生成器, "JMP_IFNOT", 比较存, 0, 空, 空, 空, 空)
      释放寄存器(生成器, 比较存)
      释放寄存器(生成器, 模式存)
      让 语句索引 = 0
      当 语句索引 < 长度(节点["分支"][索引]["主体"]) 时
        编译语句(生成器, 节点["分支"][索引]["主体"][语句索引])
        语句索引 = 语句索引 + 1
      结束
      添加(结束跳转列表, 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空))
      索引 = 索引 + 1
    结束
    如果 下一个假跳过 != 空 则
      代码修补跳转(生成器, 下一个假跳过, 代码当前位置(生成器))
    结束
    如果 节点["默认分支"] != 空 则
      让 语句索引 = 0
      当 语句索引 < 长度(节点["默认分支"]) 时
        编译语句(生成器, 节点["默认分支"][语句索引])
        语句索引 = 语句索引 + 1
      结束
    结束
    索引 = 0
    当 索引 < 长度(结束跳转列表) 时
      代码修补跳转(生成器, 结束跳转列表[索引], 代码当前位置(生成器))
      索引 = 索引 + 1
    结束
    释放寄存器(生成器, 目标存)
    返回
  结束

  如果 类型 == N_PROGRAM 则
    让 索引 = 0
    当 索引 < 长度(节点["语句"]) 时
      编译语句(生成器, 节点["语句"][索引])
      索引 = 索引 + 1
    结束
    代码发射(生成器, "HALT", 空, 空, 空, 空, 空, 空)
    返回
  结束

  如果 类型 == N_TRYCATCH 则
    让 catch_reg = 分配寄存器(生成器)
    让 捕获跳转 = 代码发射(生成器, "TRY", 0, catch_reg, 空, 空, 空, 空)
    让 索引 = 0
    当 索引 < 长度(节点["尝试块"]) 时
      编译语句(生成器, 节点["尝试块"][索引])
      索引 = 索引 + 1
    结束
    代码发射(生成器, "END_TRY", 空, 空, 空, 空, 空, 空)
    让 结束跳转 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空)
    
    代码修补跳转(生成器, 捕获跳转, 代码当前位置(生成器))
    如果 节点["变量名"] != 空 则
      如果 生成器["处于函数"] 则
        定义局部变量(生成器, 节点["变量名"], catch_reg)
      否则
        代码发射(生成器, "DEF_GLOBAL", 代码添加常量(生成器, 节点["变量名"]), catch_reg, 空, 空, 空, 空)
      结束
    结束
    
    索引 = 0
    当 索引 < 长度(节点["捕获块"]) 时
      编译语句(生成器, 节点["捕获块"][索引])
      索引 = 索引 + 1
    结束
    代码修补跳转(生成器, 结束跳转, 代码当前位置(生成器))
    返回
  结束

  如果 类型 == N_CLASSDEF 则
    让 索引 = 0
    让 方法数 = 长度(节点["方法"])
    当 索引 < 方法数 时
      编译语句(生成器, 节点["方法"][索引])
      索引 = 索引 + 1
    结束
    
    让 方法对象存 = 分配寄存器(生成器)
    让 键值起始 = 生成器["可用寄存器"]
    索引 = 0
    当 索引 < 方法数 时
      让 键存 = 分配寄存器(生成器)
      代码发射(生成器, "LOAD_CONST", 键存, 代码添加常量(生成器, 节点["方法"][索引]["名称"]), 空, 空, 空, 空)
      让 值存 = 分配寄存器(生成器)
      代码发射(生成器, "LOAD_GLOBAL", 值存, 代码添加常量(生成器, 节点["方法"][索引]["名称"]), 空, 空, 空, 空)
      索引 = 索引 + 1
    结束
    代码发射(生成器, "MAKE_OBJECT", 方法对象存, 键值起始, 方法数, 空, 空, 空)
    生成器["可用寄存器"] = 键值起始
    
    让 类存 = 分配寄存器(生成器)
    代码发射(生成器, "MAKE_CLASS", 类存, 代码添加常量(生成器, 节点["名称"]), 方法对象存, 空, 空, 空)
    代码发射(生成器, "DEF_GLOBAL", 代码添加常量(生成器, 节点["名称"]), 类存, 空, 空, 空, 空)
    释放寄存器(生成器, 类存)
    释放寄存器(生成器, 方法对象存)
    返回
  结束

  如果 类型 == N_BREAK 则
    让 指令位置 = 代码发射(生成器, "JMP", 0, 空, 空, 空, 空, 空)
    添加(生成器["跳出位置"][长度(生成器["跳出位置"]) - 1], 指令位置)
    返回
  结束

  如果 类型 == N_CONTINUE 则
    代码发射(生成器, "JMP", 生成器["继续位置"][长度(生成器["继续位置"]) - 1], 空, 空, 空, 空, 空)
    返回
  结束

  错误("暂不支持编译该语句类型: " + 类型)
结束

函数 优化字节码(生成器)
  // Register VM 暂不实现基于模式匹配的优化
结束

// ═══════════════════════════════════════════════════════════════
//  字节码输出 — 生成 .zab JSON
// ═══════════════════════════════════════════════════════════════

函数 序列化JSON值(值)
  // 先检查类型，避免 0 == 假 的问题
  如果 类型(值) == "整数" 或者 类型(值) == "浮点数" 则
    返回 转换文字(值)
  结束
  如果 值 == 空 则 返回 "null" 结束
  如果 值 == 真 则 返回 "true" 结束
  如果 值 == 假 则 返回 "false" 结束
  // 数组
  如果 类型(值) == "数组" 则
    返回 序列化JSON数组(值)
  结束
  // 字符串 — 转义
  让 结果 = "\""
  让 索引值 = 0
  当 索引值 < 长度(值) 时
    让 字符 = 值[索引值]
    如果 字符 == "\"" 则 结果 = 结果 + "\\\""
    否则如果 字符 == "\\" 则 结果 = 结果 + "\\\\"
    否则如果 字符 == "\n" 则 结果 = 结果 + "\\n"
    否则如果 字符 == "\t" 则 结果 = 结果 + "\\t"
    否则 结果 = 结果 + 字符
    结束
    索引值 = 索引值 + 1
  结束
  返回 结果 + "\""
结束

函数 序列化JSON数组(数组)
  让 结果 = "["
  让 索引值 = 0
  当 索引值 < 长度(数组) 时
    如果 索引值 > 0 则 结果 = 结果 + "," 结束
    结果 = 结果 + 序列化JSON值(数组[索引值])
    索引值 = 索引值 + 1
  结束
  返回 结果 + "]"
结束

函数 字节码转JSON(常量池, 指令列表)
  让 结果 = "{\n  \"constants\": "
  结果 = 结果 + 序列化JSON数组(常量池)
  结果 = 结果 + ",\n  \"instructions\": [\n"
  让 索引值 = 0
  当 索引值 < 长度(指令列表) 时
    如果 索引值 > 0 则 结果 = 结果 + ",\n" 结束
    结果 = 结果 + "    " + 序列化JSON数组(指令列表[索引值])
    索引值 = 索引值 + 1
  结束
  结果 = 结果 + "\n  ]\n}"
  返回 结果
结束

函数 转换为整数(值)
  让 结果 = 0
  让 文本 = 转换文字(值)
  让 索引值 = 0
  让 有小数点 = 假
  当 索引值 < 长度(文本) 时
    让 字符 = 文本[索引值]
    如果 字符 == "." 则
      有小数点 = 真
    否则如果 非 有小数点 并且 字符 >= "0" 并且 字符 <= "9" 则
      结果 = 结果 * 10 + (字符码(字符) - 48)
    结束
    索引值 = 索引值 + 1
  结束
  返回 结果
结束


// ═══════════════════════════════════════════════════════════════
//  主入口
// ═══════════════════════════════════════════════════════════════

函数 编译文件(输入文件, 输出文件)
  // 读取源码
  让 源码 = 读文件(输入文件)?
  如果 源码 == 空 或者 源码 == "" 则
    错误("无法读取文件: " + 输入文件)
  结束

  // 词法分析
  让 词法分析器 = 新建词法分析器(源码, 输入文件)
  让 词法单元 = 词法生成(词法分析器)

  // 语法分析
  让 语法分析器 = 新建语法分析器(词法单元, 输入文件)
  让 AST = 解析程序(语法分析器)

  // 代码生成
  让 生成器 = 新建代码生成器()
  编译节点(生成器, AST, 0)
  优化字节码(生成器)

  // 输出JSON字节码
  让 JSON输出 = 字节码转JSON(生成器["常量池"], 生成器["指令"])
  写文件(输出文件, JSON输出)?

  输出("编译成功: " + 输入文件 + " → " + 输出文件)
  输出("  常量数: " + 转换文字(长度(生成器["常量池"])))
  输出("  指令数: " + 转换文字(长度(生成器["指令"])))
结束

// ─── 执行 ───
让 参数 = 命令行参数()

如果 长度(参数) < 1 则
  输出("致爱编译器 v1.0")
  输出("用法: python -m zhiai compiler/main.za <输入.za> [-o 输出.zab]")
  退出(1)
结束

让 输入文件 = 参数[0]
让 输出文件 = 空

如果 长度(参数) >= 3 并且 参数[1] == "-o" 则
  输出文件 = 参数[2]
否则
  输出文件 = 截取(输入文件, 0, 长度(输入文件) - 3) + ".zab"
结束

输出("致爱编译器 v1.0")
输出("正在编译: " + 输入文件)
编译文件(输入文件, 输出文件)
