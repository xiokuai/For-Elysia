// 致爱编译器 — Token类型常量
// 词法分析器和语法分析器共享的常量定义

常量 TT_NUMBER = "NUMBER"
常量 TT_STRING = "STRING"
常量 TT_IDENT = "IDENT"
常量 TT_EOF = "EOF"

// 关键字token类型
常量 TT_LET = "LET"
常量 TT_CONST = "CONST"
常量 TT_IF = "IF"
常量 TT_ELIF = "ELIF"
常量 TT_ELSE = "ELSE"
常量 TT_WHILE = "WHILE"
常量 TT_FOR = "FOR"
常量 TT_FROM = "FROM"
常量 TT_TO = "TO"
常量 TT_STEP = "STEP"
常量 TT_EACH = "EACH"
常量 TT_IN = "IN"
常量 TT_MID = "MID"
常量 TT_FUNC = "FUNC"
常量 TT_RETURN = "RETURN"
常量 TT_BREAK = "BREAK"
常量 TT_CONTINUE = "CONTINUE"
常量 TT_TRUE = "TRUE"
常量 TT_FALSE = "FALSE"
常量 TT_NULL = "NULL"
常量 TT_AND = "AND"
常量 TT_OR = "OR"
常量 TT_NOT = "NOT"
常量 TT_TRY = "TRY"
常量 TT_CATCH = "CATCH"
常量 TT_END = "END"

// 运算符
常量 TT_PLUS = "PLUS"
常量 TT_MINUS = "MINUS"
常量 TT_STAR = "STAR"
常量 TT_SLASH = "SLASH"
常量 TT_PERCENT = "PERCENT"
常量 TT_POWER = "POWER"
常量 TT_EQ = "EQ"
常量 TT_EQEQ = "EQEQ"
常量 TT_NEQ = "NEQ"
常量 TT_LT = "LT"
常量 TT_GT = "GT"
常量 TT_LTE = "LTE"
常量 TT_GTE = "GTE"
常量 TT_NOT_BANG = "NOT_BANG"
常量 TT_AND_AND = "AND_AND"
常量 TT_OR_OR = "OR_OR"
常量 TT_PLUS_EQ = "PLUS_EQ"
常量 TT_MINUS_EQ = "MINUS_EQ"
常量 TT_STAR_EQ = "STAR_EQ"
常量 TT_SLASH_EQ = "SLASH_EQ"

// 分隔符
常量 TT_LPAREN = "LPAREN"
常量 TT_RPAREN = "RPAREN"
常量 TT_LBRACKET = "LBRACKET"
常量 TT_RBRACKET = "RBRACKET"
常量 TT_LBRACE = "LBRACE"
常量 TT_RBRACE = "RBRACE"
常量 TT_COMMA = "COMMA"
常量 TT_COLON = "COLON"
常量 TT_DOT = "DOT"

// AST节点类型
常量 N_PROGRAM = "PROGRAM"
常量 N_VARDECL = "VARDECL"
常量 N_CONSTDECL = "CONSTDECL"
常量 N_EXPRSTMT = "EXPRSTMT"
常量 N_IF = "IF"
常量 N_WHILE = "WHILE"
常量 N_FOR = "FOR"
常量 N_FOREACH = "FOREACH"
常量 N_FUNCDEF = "FUNCDEF"
常量 N_RETURN = "RETURN"
常量 N_BREAK = "BREAK"
常量 N_CONTINUE = "CONTINUE"
常量 N_TRYCATCH = "TRYCATCH"
常量 N_NUMBER = "NUMBER"
常量 N_STRING = "STRING"
常量 N_BOOL = "BOOL"
常量 N_NULL = "NULL"
常量 N_ARRAY = "ARRAY"
常量 N_OBJECT = "OBJECT"
常量 N_IDENT = "IDENT"
常量 N_UNARY = "UNARY"
常量 N_BINARY = "BINARY"
常量 N_ASSIGN = "ASSIGN"
