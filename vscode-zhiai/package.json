{
  "name": "zhiai",
  "displayName": "致爱 (Zhiai) Language Support",
  "description": "Syntax highlighting and autocomplete for Zhiai programming language",
  "version": "1.0.5",
  "publisher": "zhiai-team",
  "icon": "logo.png",
  "repository": "https://github.com/example/zhiai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zhiai",
        "aliases": [
          "Zhiai",
          "zhiai",
          "致爱"
        ],
        "extensions": [
          ".za",
          ".zab"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zhiai",
        "scopeName": "source.zhiai",
        "path": "./syntaxes/zhiai.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zhiai",
        "path": "./snippets/snippets.json"
      }
    ],
    "commands": [
      {
        "command": "zhiai.runFile",
        "title": "运行致爱脚本",
        "icon": "$(play)"
      },
      {
        "command": "zhiai.compileExe",
        "title": "打包为 EXE",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zhiai.runFile",
          "when": "resourceExtname == .za",
          "group": "navigation"
        },
        {
          "command": "zhiai.compileExe",
          "when": "resourceExtname == .za",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "zhiai",
        "label": "致爱调试器",
        "languages": [
          "zhiai"
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:zhiai"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.3"
  }
}
