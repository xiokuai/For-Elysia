// 验证 v1.0.12 现代语法糖：模式匹配、? 传播与字符串插值
输出("=== 现代语法糖验证 ===")

// 1. 字符串插值 (Interpolation)
让 名字 = "致爱"
让 版本 = "1.0.11"
输出("你好，我是{名字}，当前版本是{版本}")

// 2. 模式匹配 (Pattern Matching)
函数 评价分数(分)
    匹配 分 于
        100: 输出("满分！")
        90:  输出("优秀")
        60:  输出("及格")
        否则: 输出("继续努力")
    结束
结束

评价分数(90)
评价分数(45)

// 3. ? 传播语法糖 (Result Propagation)
函数 危险运算(x)
    如果 x < 0 则 返回 失败("不能为负数") 结束
    返回 成功(x * 10)
结束

函数 调用链(x)
    让 结果 = 危险运算(x)? // 如果失败直接返回，否则解包
    输出("计算成功，得到：" + 转换文字(结果))
    返回 成功(结果)
结束

输出("测试有效输入:")
调用链(5)
输出("测试无效输入:")
让 最终结果 = 调用链(-1)
输出("顶层捕获到传播的失败：" + 最终结果.获取错误())

输出("=== 验证完成 ===")
