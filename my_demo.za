// 致爱语言示例：九九乘法表与冒泡排序

输出("=== 九九乘法表 ===")
让 行 = 1
当 行 <= 9 时
  让 列 = 1
  让 行字符串 = ""
  当 列 <= 行 时
    让 乘积 = 行 * 列
    行字符串 = 行字符串 + 转换文字(列) + "x" + 转换文字(行) + "=" + 转换文字(乘积) + "  "
    列 = 列 + 1
  结束
  输出(行字符串)
  行 = 行 + 1
结束

输出("")
输出("=== 冒泡排序演示 ===")
让 数组 = [64, 34, 25, 12, 22, 11, 90]
输出("排序前: " + 转换文字(数组))

让 数组长度 = 长度(数组)
让 i = 0
当 i < 数组长度 - 1 时
  让 j = 0
  当 j < 数组长度 - i - 1 时
    如果 数组[j] > 数组[j + 1] 则
      // 交换
      让 临时 = 数组[j]
      数组[j] = 数组[j + 1]
      数组[j + 1] = 临时
      结束
      j = j + 1
    结束
    i = i + 1
  结束

  输出("排序后: " + 转换文字(数组))


  // --- 对象和数组操作示例 ---

  // 创建对象
  让 用户 = {"姓名": "小明", "年龄": 20, "城市": "北京"}
  输出("=== 对象操作 ===")
  输出("姓名: " + 用户["姓名"])
  输出("年龄: " + 用户["年龄"])

  // 创建数组
  让 数字列表 = [10, 5, 8, 2, 9]
  输出("\n=== 数组操作 ===")
  输出("原始数组: " + 数字列表)

  // 排序
  数字列表 = 排序(数字列表)
  输出("排序后: " + 数字列表)

  // 筛选（用匿名函数）
  让 大于5 = 筛选(数字列表, 函数(数字) 返回 数字 > 5 结束)
  输出("大于5的数: " + 大于5)

  // 映射
  让 平方 = 映射(数字列表, 函数(数字) 返回 数字 * 数字 结束)
  输出("平方列表: " + 平方)
